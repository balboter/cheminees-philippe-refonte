---
import "@fontsource/mulish/400.css";
import "@fontsource/mulish/500.css";
import "@fontsource/mulish/600.css";
import "@fontsource/mulish/700.css";
import "../styles/fraunces-optional.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import BannerSaisonnier from "../components/BannerSaisonnier.astro";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  schema?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-default.jpg",
  schema,
  noindex = false,
} = Astro.props;

const siteName = "Cheminées Philippe Évreux";
const fullTitle = title.toLowerCase().includes("philippe") ? title : `${title} | ${siteName}`;

const cleanURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const canonicalURL = Astro.props.canonicalURL ?? cleanURL;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://cheminees-poeles-philippe.com/#organization",
  name: "Loisirs Habitat Diffusion — Cheminées Philippe",
  alternateName: "Cheminées Philippe Évreux",
  url: "https://cheminees-poeles-philippe.com",
  logo: "https://cheminees-poeles-philippe.com/favicon-512.png",
  image: "https://cheminees-poeles-philippe.com/og-default.jpg",
  telephone: "+33232333193",
  email: "cheminexpo@wanadoo.fr",
  priceRange: "€€-€€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Centre commercial Caer, Route de Rouen",
    addressLocality: "Normanville",
    postalCode: "27930",
    addressRegion: "Normandie",
    addressCountry: "FR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "49.0345",
    longitude: "1.1845",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "12:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "14:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "10:00",
      closes: "12:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "14:00",
      closes: "18:00",
    },
  ],
  founder: "Julien Verger",
  foundingDate: "1986",
  description:
    "Concessionnaire Cheminées Philippe depuis 1986. Cheminées sur mesure, inserts, foyers et poêles à bois et à granulés, installation clé en main dans l'Eure et en Normandie.",
  areaServed: [
    { "@type": "AdministrativeArea", name: "Eure" },
    { "@type": "AdministrativeArea", name: "Seine-Maritime" },
    { "@type": "AdministrativeArea", name: "Eure-et-Loir" },
    { "@type": "AdministrativeArea", name: "Orne" },
    { "@type": "AdministrativeArea", name: "Yvelines" },
  ],
};
---

<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/favicon-512.png")} />
    <meta name="generator" content={Astro.generator} />
    <!-- PREVIEW GitHub Pages : retirer le noindex à la bascule sur le domaine final -->
    <meta name="robots" content="noindex,nofollow" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url(image), Astro.site ?? Astro.url).toString()} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(url(image), Astro.site ?? Astro.url).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded focus:shadow-lg"
    >
      Aller au contenu principal
    </a>
    <BannerSaisonnier />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
  </body>
</html>

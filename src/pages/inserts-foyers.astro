---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import AidesEstimator from "../components/AidesEstimator.astro";
import { url } from "../lib/url";

const avantages = [
  {
    titre: "Un vrai rendement",
    texte:
      "Un foyer ouvert laisse partir 85 % de la chaleur dans le conduit. Un insert fermé Cheminées Philippe dépasse 75 % de rendement : la même flambée chauffe enfin votre pièce.",
  },
  {
    titre: "Des économies concrètes",
    texte:
      "Mieux la chaleur est captée, moins vous brûlez de bois. Un insert réduit nettement votre consommation et vient en complément ou en relais d'un chauffage central coûteux.",
  },
  {
    titre: "La sécurité retrouvée",
    texte:
      "Vitre fermée, plus de projection d'étincelles, conduit tubé aux normes. L'insert protège la maison et les enfants, tout en gardant le spectacle des flammes.",
  },
];

const modeles = [
  {
    nom: "CLECY",
    type: "Insert bois",
    rendement: "> 75 %",
    ideal: "Rénover une cheminée existante de taille moyenne",
    image: "/images/installations/148.webp",
    alt: "Insert bois Cheminées Philippe modèle CLECY intégré dans une cheminée maçonnée",
    desc:
      "L'insert polyvalent pour redonner vie à une cheminée à foyer ouvert. Grande vitre, combustion propre, intégration soignée dans l'habillage existant.",
  },
  {
    nom: "ANTHEM 65F",
    type: "Foyer fermé bois",
    rendement: "> 75 %",
    ideal: "Cheminée neuve, ouverture frontale classique",
    image: "/images/installations/137.webp",
    alt: "Foyer fermé bois Cheminées Philippe modèle ANTHEM 65F à vitre frontale",
    desc:
      "Un foyer fermé à vitre frontale pour un projet de cheminée neuve. Format 65 cm, lignes nettes, belle vue sur le feu.",
  },
  {
    nom: "ANTHEM 65V",
    type: "Foyer fermé bois",
    rendement: "> 75 %",
    ideal: "Cheminée d'angle, foyer visible sur deux faces",
    image: "/images/installations/183.webp",
    alt: "Foyer fermé bois Cheminées Philippe modèle ANTHEM 65V à vitre d'angle",
    desc:
      "La version vitrée d'angle de l'ANTHEM. Idéale pour une cheminée placée entre deux espaces, avec le feu visible sous deux angles.",
  },
  {
    nom: "ANTHEM 75F",
    type: "Foyer fermé bois",
    rendement: "> 75 %",
    ideal: "Grandes pièces, large foyer panoramique",
    image: "/images/installations/126.webp",
    alt: "Foyer fermé bois Cheminées Philippe modèle ANTHEM 75F à grande vitre panoramique",
    desc:
      "Le grand format de la gamme : 75 cm d'ouverture pour une flamme généreuse. Pour les séjours spacieux qui veulent une vraie pièce centrale.",
  },
];
---

<BaseLayout
  title="Inserts & foyers Cheminées Philippe — Évreux & Normandie"
  description="Inserts et foyers fermés Cheminées Philippe : rendement supérieur à 75 %, rénovation de cheminée et installation par nos techniciens dans l'Eure. Devis sous 48 h."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Inserts & foyers
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight font-display">
        Une cheminée qui chauffe vraiment
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-3xl leading-relaxed">
        Vous avez une cheminée à foyer ouvert qui fait plus de fumée que de
        chaleur ? Un insert Cheminées Philippe la transforme en source de chauffe
        performante — sans rien perdre du plaisir des flammes.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30"
        >
          Demander un devis
        </a>
        <a
          href="tel:+33232333193"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 33 31 93
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-14">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Pourquoi un insert
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Trois bonnes raisons de fermer le foyer
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Un insert, c'est une vitre, un foyer fermé et un rendement multiplié. Le
          confort change, la facture aussi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {avantages.map((a) => (
          <article class="p-7 sm:p-8 rounded-2xl bg-warm-50 border border-warm-100">
            <h3 class="text-xl font-bold text-ink-900 font-display">{a.titre}</h3>
            <p class="mt-3 text-ink-700 leading-relaxed">{a.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <figure class="overflow-hidden rounded-2xl border border-warm-100 order-last lg:order-first">
          <img
            src={url("/images/installations/128.webp")}
            alt="Cheminée ancienne rénovée avec un insert Cheminées Philippe, habillage pierre préservé"
            width="800"
            height="600"
            loading="lazy"
            class="w-full aspect-[4/3] object-cover"
          />
        </figure>
        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-brand-500"></span>
            Cas rénovation
          </p>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
            Moderniser une cheminée existante
          </h2>
          <p class="mt-4 text-base sm:text-lg text-ink-700 leading-relaxed">
            La plupart de nos clients ont déjà une cheminée. Pas besoin de tout
            casser : on garde le caractère et l'habillage que vous aimez, et on y
            intègre un foyer fermé performant.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="flex-shrink-0 w-5 h-5 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Visite technique : on vérifie le conduit, les dimensions et le tirage.</span>
            </li>
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="flex-shrink-0 w-5 h-5 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Tubage du conduit aux normes, posé par nos techniciens.</span>
            </li>
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="flex-shrink-0 w-5 h-5 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Habillage préservé ou retouché selon l'état, finitions soignées.</span>
            </li>
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="flex-shrink-0 w-5 h-5 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Mise en service et explication du fonctionnement le jour de la pose.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos modèles
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Inserts & foyers Cheminées Philippe
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Tous nos foyers dépassent 75 % de rendement. Le bon modèle dépend de
          votre cheminée et de votre pièce — notre conseiller vous oriente sur
          place.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {modeles.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-warm-50 border border-warm-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={url(m.image)}
                alt={m.alt}
                width="700"
                height="525"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
            </div>
            <div class="p-6 sm:p-7">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider">{m.type}</p>
                  <h3 class="mt-1 text-xl font-bold text-ink-900 font-display">{m.nom}</h3>
                </div>
                <span class="flex-shrink-0 px-2.5 py-1 text-xs font-semibold text-brand-700 bg-brand-50 rounded">
                  {m.rendement}
                </span>
              </div>
              <p class="mt-3 text-ink-700 leading-relaxed text-sm">{m.desc}</p>
              <div class="mt-4 pt-4 border-t border-warm-200">
                <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Idéal pour</p>
                <p class="mt-1 text-sm text-ink-700 font-medium">{m.ideal}</p>
              </div>
              <a
                href={url(`/contact?modele=${encodeURIComponent(m.nom)}&type=insert`)}
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
              >
                Demander un devis sur ce modèle
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AidesEstimator />

  <CTA
    heading="Transformez votre cheminée"
    description="Visite technique gratuite : nous étudions votre conduit et votre foyer, puis nous vous proposons l'insert adapté. Devis sous 48 h."
  />
</BaseLayout>

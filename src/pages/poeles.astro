---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import ComparatifBoisGranules from "../components/ComparatifBoisGranules.astro";
import PuissanceCalculator from "../components/PuissanceCalculator.astro";
import AidesEstimator from "../components/AidesEstimator.astro";
import { url } from "../lib/url";

const poelesBois = [
  {
    nom: "BREVAL",
    image: "/images/installations/129.webp",
    alt: "Poêle à bois Cheminées Philippe modèle BREVAL en fonte dans un séjour",
    desc: "Un poêle compact à la silhouette classique, parfait en chauffage d'appoint ou pour une pièce à vivre de taille mesurée.",
  },
  {
    nom: "AZUR",
    image: "/images/installations/123.webp",
    alt: "Poêle à bois Cheminées Philippe modèle AZUR avec large vitre",
    desc: "Lignes nettes et belle vue sur le feu. Polyvalent, il s'adapte à la plupart des séjours de pavillon.",
  },
  {
    nom: "CLISSON",
    image: "/images/installations/130.webp",
    alt: "Poêle à bois Cheminées Philippe modèle CLISSON au design contemporain",
    desc: "Le poêle au caractère contemporain. Vitre généreuse, allure épurée, pour les intérieurs modernes.",
    best: true,
  },
  {
    nom: "REYNEL 2",
    image: "/images/installations/137.webp",
    alt: "Poêle à bois Cheminées Philippe modèle REYNEL 2 pour grand volume",
    desc: "Une bonne capacité de chauffe pour les pièces ouvertes et les séjours spacieux. Flambées longues et régulières.",
  },
  {
    nom: "SOPRAZ",
    image: "/images/installations/145.webp",
    alt: "Poêle à bois Cheminées Philippe modèle SOPRAZ en fonte",
    desc: "Robuste et chaleureux, le SOPRAZ mise sur la fonte massive et une chauffe homogène dans la durée.",
  },
  {
    nom: "BERSAY 2",
    image: "/images/installations/147.webp",
    alt: "Poêle à bois Cheminées Philippe modèle BERSAY 2 au design géométrique",
    desc: "Un dessin moderne et un dessus chauffant. Pour les intérieurs qui aiment les lignes franches.",
  },
  {
    nom: "THEZEE",
    image: "/images/installations/155.webp",
    alt: "Poêle à bois Cheminées Philippe modèle THEZEE installé dans une pièce de vie",
    desc: "L'équilibre entre tradition et performance : un poêle accessible, simple à vivre, qui chauffe bien.",
  },
];

const poelesGranules = [
  {
    nom: "SOLAIME",
    rendement: "> 90 %",
    image: "/images/installations/164.webp",
    alt: "Poêle à granulés Cheminées Philippe modèle SOLAIME avec programmation",
    desc: "Programmation, allumage automatique, rendement supérieur à 90 %. Le confort d'un chauffage qui s'occupe de lui-même.",
  },
  {
    nom: "PELLETS PLUS 3",
    rendement: "> 90 %",
    image: "/images/installations/165.webp",
    alt: "Poêle à granulés Cheminées Philippe modèle PELLETS PLUS 3 grande capacité",
    desc: "Réservoir généreux et longue autonomie : un week-end entier sans recharge. Idéal en chauffage principal.",
    best: true,
  },
];
---

<BaseLayout
  title="Poêles bois & granulés Philippe — Évreux & Normandie"
  description="Poêles à bois et à granulés Cheminées Philippe, posés par nos équipes dans l'Eure et en Normandie. Conseil et devis sous 48 h."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Poêles à bois & à granulés
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight font-display">
        Un poêle, deux façons de chauffer
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-3xl leading-relaxed">
        Le poêle s'installe sans gros travaux et chauffe vite. Reste à choisir
        entre le geste du bois et l'automatisme des granulés. On vous aide à
        trancher, puis nos équipes posent l'appareil chez vous.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30"
        >
          Demander un devis
        </a>
        <a
          href="tel:+33232333193"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 33 31 93
        </a>
      </div>
    </div>
  </section>

  <ComparatifBoisGranules />

  <PuissanceCalculator />

  <section class="py-16 sm:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Poêles à bois
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Le feu de bois, simple et chaleureux
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Sept modèles Cheminées Philippe, du compact au grand volume. Notre
          conseiller vous oriente vers celui qui convient à votre pièce.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {poelesBois.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-warm-50 border border-warm-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden relative">
              <img
                src={url(m.image)}
                alt={m.alt}
                width="600"
                height="450"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
              {m.best && (
                <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
                  Notre coup de cœur
                </span>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-ink-900 font-display">{m.nom}</h3>
              <p class="mt-3 text-ink-700 leading-relaxed text-sm">{m.desc}</p>
              <a
                href={url(`/contact?modele=${encodeURIComponent(m.nom)}&type=poele-bois`)}
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
              >
                Demander un devis sur ce modèle
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Poêles à granulés
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Le confort sans y penser
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Programmation, longue autonomie, rendement supérieur à 90 %. Le poêle à
          granulés Cheminées Philippe chauffe la maison pendant que vous vivez
          votre vie.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {poelesGranules.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-white border border-warm-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden relative">
              <img
                src={url(m.image)}
                alt={m.alt}
                width="700"
                height="525"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
              {m.best && (
                <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
                  Notre coup de cœur
                </span>
              )}
            </div>
            <div class="p-6 sm:p-7">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-xl font-bold text-ink-900 font-display">{m.nom}</h3>
                <span class="flex-shrink-0 px-2.5 py-1 text-xs font-semibold text-brand-700 bg-brand-50 rounded">
                  {m.rendement}
                </span>
              </div>
              <p class="mt-3 text-ink-700 leading-relaxed text-sm">{m.desc}</p>
              <a
                href={url(`/contact?modele=${encodeURIComponent(m.nom)}&type=poele-granules`)}
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
              >
                Demander un devis sur ce modèle
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AidesEstimator />

  <CTA
    heading="Trouvons votre poêle ensemble"
    description="Un conseiller se déplace gratuitement, mesure votre besoin et vous recommande le poêle adapté — bois ou granulés. Devis sous 48 h."
  />
</BaseLayout>

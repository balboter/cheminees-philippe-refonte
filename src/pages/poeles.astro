---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import Manifeste from "../components/Manifeste.astro";
import CTA from "../components/CTA.astro";

const poelesBois = [
  "Chaume 3",
  "Breteuil 2",
  "Saulieu 2",
  "Dainville",
  "Bilby",
  "Tournay",
  "Cedrus",
  "Venière",
];

const poelesGranules = [
  "Solaime 2",
  "Maylis 2",
  "Cayrol 2",
  "Pradines 2",
  "Thibery 2",
  "Marcoux 2",
];
---

<BaseLayout
  title="Poêles à bois & à granulés Cheminées Philippe — Évreux"
  description="La gamme de poêles à bois et à granulés Cheminées Philippe, posés par nos équipes dans l'Eure. Conseil personnalisé au showroom de Normanville."
>
  <HeroEditorial
    kicker="Poêles à bois & à granulés"
    title="Le poêle, quand la cheminée n'est pas l'option"
    intro="Le poêle s'installe sans gros travaux et chauffe vite. La maison Cheminées Philippe en propose une gamme, du feu de bûches à l'automatisme des granulés."
    image="/images/installations/149.webp"
    imageAlt="Poêle installé dans une pièce de vie, le feu allumé"
    ctaLabel="Échanger sur votre projet"
    ctaHref="/contact"
    height="short"
  />

  <Manifeste
    kicker="La gamme Cheminées Philippe"
    title="Deux feux, deux façons de vivre la chaleur"
    paragraphs={[
      "Le poêle à bois, c'est le geste : fendre, charger, regarder la flambée prendre. Une chaleur franche et un plaisir simple, pour qui aime s'occuper de son feu.",
      "Le poêle à granulés, c'est l'automatisme : on programme, on remplit le réservoir, l'appareil fait le reste. La chaleur du bois, sans la contrainte du quotidien.",
      "Le bon choix dépend de votre maison, de votre rythme et de votre rapport au feu. C'est exactement le genre de conversation qui se mène mieux au showroom, devant les modèles.",
    ]}
  />

  <section class="bg-white py-20 sm:py-28 lg:py-36">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-brand-600">
            Poêles à bois
          </p>
          <h2 class="mt-3 font-display text-2xl sm:text-3xl text-ink-900">
            Le feu de bûches
          </h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Du modèle compact au grand volume, pour le chauffage d'appoint comme
            pour la pièce de vie principale.
          </p>
          <ul class="mt-7 divide-y divide-warm-100 border-y border-warm-100">
            {poelesBois.map((nom) => (
              <li class="py-3.5 font-display text-lg text-ink-900">{nom}</li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-brand-600">
            Poêles à granulés
          </p>
          <h2 class="mt-3 font-display text-2xl sm:text-3xl text-ink-900">
            Le confort automatique
          </h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Programmation, longue autonomie, allumage automatique : la chaleur du
            bois pendant que vous vivez votre vie.
          </p>
          <ul class="mt-7 divide-y divide-warm-100 border-y border-warm-100">
            {poelesGranules.map((nom) => (
              <li class="py-3.5 font-display text-lg text-ink-900">{nom}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f4efe7] py-20 sm:py-28 lg:py-36">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-600">
        Le conseil au showroom
      </p>
      <h2 class="mt-6 font-display font-semibold text-ink-900 leading-[1.15] text-3xl sm:text-4xl">
        Un poêle se choisit en le voyant
      </h2>
      <p class="mt-6 text-lg text-ink-600 leading-loose">
        La taille, la matière, la place dans la pièce, le volume à chauffer : ces
        questions trouvent leurs réponses au showroom de Normanville, devant les
        appareils. Nos conseillers prennent le temps d'en parler avec vous, sans
        rien vous vendre dans l'urgence.
      </p>
    </div>
  </section>

  <CTA
    kicker="Parlons-en"
    heading="Trouvons votre poêle ensemble"
    description="Un conseiller vous reçoit au showroom ou se déplace chez vous pour évaluer votre besoin et vous orienter — bois ou granulés."
  />
</BaseLayout>

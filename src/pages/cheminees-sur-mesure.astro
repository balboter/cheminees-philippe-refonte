---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import ProjetTroisTemps from "../components/ProjetTroisTemps.astro";
import Realisations from "../components/Realisations.astro";
import PourquoiNous from "../components/PourquoiNous.astro";
import CTA from "../components/CTA.astro";
import { url } from "../lib/url";

const benefices = [
  {
    titre: "Une cheminée qui s'ajuste à votre pièce",
    texte:
      "Pas l'inverse. Dimensions, conduit, lumière : votre cheminée est dessinée pour cet espace précis, jamais imposée par un catalogue.",
  },
  {
    titre: "Fabriquée en France, posée par nos équipes",
    texte:
      "Cheminées Philippe façonne la matière depuis 1961. Nos techniciens salariés assurent la pose et la mise en service. Un seul interlocuteur.",
  },
  {
    titre: "Un devis clair, sans mauvaise surprise",
    texte:
      "Après la visite-conseil gratuite, vous recevez un projet chiffré : matières, dimensions, délai. Vous validez avant tout démarrage.",
  },
];

const temps = [
  {
    titre: "La visite-conseil, chez vous et gratuite",
    texte:
      "Le conseiller mesure la pièce, observe la lumière, repère la place du conduit, écoute votre besoin. De cette visite naît le dessin de votre cheminée — et un devis clair.",
  },
  {
    titre: "La fabrication, en atelier français",
    texte:
      "Le projet validé rejoint les ateliers Cheminées Philippe. Pierre taillée, fonte coulée, marbre poli, fer forgé : chaque pièce est façonnée à vos dimensions.",
  },
  {
    titre: "La pose, par nos techniciens",
    texte:
      "Nos équipes installent la cheminée, raccordent le conduit aux normes, ajustent les finitions, puis allument le premier feu avec vous.",
  },
];

const realisations = [
  {
    image: "/images/installations/166.webp",
    alt: "Cheminée habillée de marbre clair installée dans un salon",
    legende: "Habillage de marbre clair",
    lieu: "Vernon",
  },
  {
    image: "/images/installations/178.webp",
    alt: "Cheminée d'angle sur mesure intégrée dans une pièce de vie",
    legende: "Cheminée d'angle sur mesure",
    lieu: "Louviers",
  },
  {
    image: "/images/installations/196.webp",
    alt: "Cheminée maçonnée sur mesure habillée de pierre",
    legende: "Habillage de pierre maçonné",
    lieu: "Gisors",
  },
];

const atouts = [
  {
    titre: "Cinq métiers réunis chez le fabricant",
    texte:
      "Fonderie, marbrerie, ferronnerie, céramique, émail : c'est cette concentration de savoir-faire qui rend le vrai sur-mesure possible.",
  },
  {
    titre: "Des poseurs salariés, jamais de sous-traitance",
    texte:
      "La même maison conçoit, fait fabriquer et installe. Vous gardez un seul interlocuteur du devis au SAV.",
  },
  {
    titre: "Un accompagnement jusqu'au premier feu",
    texte:
      "Le jour de la mise en service, nos techniciens allument le feu avec vous et vous expliquent comment en prendre soin.",
  },
];
---

<BaseLayout
  title="Cheminée sur mesure Eure — Philippe, devis gratuit"
  description="Une cheminée sur mesure dessinée pour votre pièce, fabriquée en France et posée dans l'Eure par nos équipes. Visite-conseil et devis gratuits, sans engagement."
>
  <HeroEditorial
    kicker="Cheminées sur mesure"
    title="Une cheminée dessinée pour votre pièce, posée clé en main"
    intro="Le sur-mesure enlève le hasard : votre cheminée part de vos murs, de votre conduit, de votre lumière. Conçue, fabriquée et installée par une seule maison."
    image="/images/installations/178.webp"
    imageAlt="Cheminée d'angle sur mesure installée dans un séjour, le feu allumé"
    ctaLabel="Demander un devis gratuit"
    ctaHref="/contact"
    reassurance="Visite-conseil gratuite à domicile, partout dans l'Eure."
    height="short"
  />

  <section class="bg-white py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-700 font-semibold">
          Pourquoi le sur-mesure
        </p>
        <h2 class="mt-4 font-display font-semibold text-ink-900 leading-[1.12] text-3xl sm:text-4xl lg:text-5xl">
          Trois bonnes raisons de nous confier votre projet
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {benefices.map((b) => (
          <article class="rounded-xl border border-warm-100 bg-warm-50 p-7 sm:p-8">
            <span class="flex items-center justify-center w-11 h-11 rounded-full bg-brand-500 text-white" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <h3 class="mt-5 font-display text-xl sm:text-2xl text-ink-900">
              {b.titre}
            </h3>
            <p class="mt-3 text-ink-600 leading-relaxed">{b.texte}</p>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-brand-600 text-white text-lg font-bold hover:bg-brand-700 transition-colors duration-300"
        >
          Demander un devis gratuit
        </a>
      </div>
    </div>
  </section>

  <ProjetTroisTemps
    kicker="Le sur-mesure expliqué"
    title="De la visite-conseil au premier feu"
    intro="Trois étapes, un seul interlocuteur. La première — la visite-conseil — est gratuite et sans engagement."
    temps={temps}
    variant="cream"
    ctaLabel="Demander un devis gratuit"
    ctaHref="/contact"
  />

  <Realisations
    kicker="Nos réalisations"
    title="Des cheminées sur mesure posées près de chez vous"
    intro="Conçues, fabriquées et installées pour de vrais intérieurs de l'Eure et de Normandie. La preuve concrète de notre savoir-faire."
    items={realisations}
    lienLabel="Voir toutes nos réalisations"
    lienHref="/realisations"
    variant="white"
  />

  <PourquoiNous
    kicker="Pourquoi nous choisir"
    title="Le savoir-faire d'un fabricant, le suivi d'un artisan local"
    intro="Vous bénéficiez d'un produit façonné en France et d'une équipe locale qui connaît vos maisons normandes — et reste joignable une fois le feu allumé."
    image="/images/installations/166.webp"
    imageAlt="Gros plan sur l'habillage de pierre et de marbre d'une cheminée Cheminées Philippe"
    atouts={atouts}
    variant="warm"
  />

  <CTA
    kicker="Votre projet"
    heading="Et si votre cheminée prenait forme ?"
    description="Un conseiller se déplace gratuitement, prend les mesures et vous remet un devis clair, adapté à votre pièce."
    ctaLabel="Demander un devis gratuit"
  />
</BaseLayout>
</content>

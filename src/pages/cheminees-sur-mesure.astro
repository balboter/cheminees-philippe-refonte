---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { url } from "../lib/url";

const etapes = [
  {
    num: "1",
    titre: "On dessine avec vous",
    texte:
      "Un conseiller vient mesurer votre pièce, observe la lumière, le style de votre intérieur. De là naît un projet de cheminée pensé pour cet espace précis — pas un modèle de catalogue posé au hasard.",
  },
  {
    num: "2",
    titre: "L'atelier Philippe fabrique",
    texte:
      "Cheminées Philippe fabrique en France depuis 1961 : fonderie, ferronnerie et marbrerie réunies sous un même toit. Votre habillage est façonné sur mesure, pierre par pierre, pièce par pièce.",
  },
  {
    num: "3",
    titre: "Nos équipes installent",
    texte:
      "Nos techniciens posent la cheminée chez vous, soignent les raccords et les finitions, puis vous remettent un foyer prêt à allumer. Un seul interlocuteur, du premier croquis au premier feu.",
  },
];

const matieres = [
  {
    titre: "La pierre",
    texte:
      "Pierre de taille, pierre reconstituée ou pierre bleue : la matière noble qui donne à une cheminée son poids et sa présence. Chaque bloc est choisi et ajusté à votre habillage.",
  },
  {
    titre: "La fonte",
    texte:
      "Le cœur de la cheminée. La fonte emmagasine la chaleur et la restitue longtemps après la flambée. Un savoir-faire de fonderie hérité de plus de soixante ans de fabrication.",
  },
  {
    titre: "La ferronnerie",
    texte:
      "Linteaux, contrecœurs, détails forgés : la ferronnerie d'art apporte le caractère. Des pièces travaillées à la main qui font la différence entre un foyer et une vraie cheminée.",
  },
  {
    titre: "La marbrerie",
    texte:
      "Tablettes, jambages et encadrements en marbre, taillés et polis en atelier. La finition qui transforme une cheminée en pièce maîtresse de votre salon.",
  },
];

const inspirations = [
  {
    nom: "SUREAU",
    style: "Cheminée contemporaine",
    texte:
      "Lignes épurées, foyer largement vitré, habillage sobre. Le SUREAU s'intègre dans un intérieur moderne sans jamais l'écraser — la flamme devient le seul ornement.",
    image: "/images/installations/126.webp",
    alt: "Cheminée Philippe contemporaine modèle SUREAU dans un séjour, habillage clair et foyer vitré",
  },
  {
    nom: "ATOLL",
    style: "Cheminée d'inspiration classique",
    texte:
      "Un hêtre de proportions généreuses, des matières chaleureuses, un foyer central. L'ATOLL fait référence à la cheminée traditionnelle, revisitée pour les rendements d'aujourd'hui.",
    image: "/images/installations/167.webp",
    alt: "Cheminée Philippe d'inspiration classique modèle ATOLL avec habillage en pierre de taille",
  },
];

const galerie = [
  { image: "/images/installations/128.webp", alt: "Cheminée Philippe sur mesure avec habillage pierre dans une maison rénovée" },
  { image: "/images/installations/167.webp", alt: "Cheminée Philippe traditionnelle en pierre de taille dans un séjour" },
  { image: "/images/installations/183.webp", alt: "Cheminée Philippe au design contemporain intégrée dans un loft" },
  { image: "/images/installations/200.webp", alt: "Foyer Philippe sur mesure habillé de pierre dans une pièce de vie" },
  { image: "/images/installations/177.webp", alt: "Cheminée Philippe avec habillage clair et tablette en marbre" },
  { image: "/images/installations/196.webp", alt: "Cheminée Philippe installée par nos équipes dans une maison de l'Eure" },
];
---

<BaseLayout
  title="Cheminées sur mesure Cheminées Philippe — Évreux & Normandie"
  description="Cheminées sur mesure Cheminées Philippe : conception, fabrication française et installation clé en main dans l'Eure. Devis gratuit sous 48 h."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Cheminées sur mesure
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight font-display">
        Votre cheminée, dessinée pour votre pièce
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-3xl leading-relaxed">
        Une cheminée sur mesure n'est pas un appareil que l'on choisit dans un
        catalogue. C'est une pièce conçue pour votre intérieur, fabriquée dans les
        ateliers Cheminées Philippe et posée chez vous par nos équipes. De l'idée
        au premier feu, un seul interlocuteur.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30"
        >
          Demander un devis
        </a>
        <a
          href="tel:+33232333193"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 33 31 93
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-14">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Le sur-mesure expliqué
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          De l'idée au feu, en trois temps
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Le sur-mesure, ce n'est pas plus compliqué qu'un modèle standard. C'est
          juste plus juste. Voici comment se déroule un projet avec nous.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {etapes.map((e) => (
          <article class="p-7 sm:p-8 rounded-2xl bg-warm-50 border border-warm-100">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-brand-500 text-white text-xl font-bold font-display">
              {e.num}
            </span>
            <h3 class="mt-5 text-xl font-bold text-ink-900 font-display">{e.titre}</h3>
            <p class="mt-3 text-ink-700 leading-relaxed">{e.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-brand-500"></span>
            Matières & savoir-faire
          </p>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
            Quatre métiers réunis dans une cheminée
          </h2>
          <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
            Cheminées Philippe fabrique en France depuis 1961. Une particularité
            rare : la fonderie, la ferronnerie et la marbrerie travaillent ensemble,
            au même endroit. C'est ce qui rend le vrai sur-mesure possible.
          </p>
        </div>
        <figure class="overflow-hidden rounded-2xl border border-warm-100">
          <img
            src={url("/images/installations/177.webp")}
            alt="Détail d'une cheminée Philippe : habillage pierre et tablette en marbre"
            width="800"
            height="600"
            loading="lazy"
            class="w-full aspect-[4/3] object-cover"
          />
        </figure>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {matieres.map((m) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-white border border-warm-100">
            <h3 class="text-xl font-bold text-ink-900 font-display">{m.titre}</h3>
            <p class="mt-3 text-ink-700 leading-relaxed">{m.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-14">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Inspirations & styles
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Deux esprits, un même soin
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Contemporaine ou classique, votre cheminée part toujours d'un modèle
          Cheminées Philippe que nous adaptons à votre pièce. Voici deux points de
          départ parmi les plus appréciés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {inspirations.map((i) => (
          <article class="rounded-2xl overflow-hidden bg-warm-50 border border-warm-100">
            <img
              src={url(i.image)}
              alt={i.alt}
              width="800"
              height="600"
              loading="lazy"
              class="w-full aspect-[4/3] object-cover"
            />
            <div class="p-6 sm:p-7">
              <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider">{i.style}</p>
              <h3 class="mt-1 text-2xl font-bold text-ink-900 font-display">{i.nom}</h3>
              <p class="mt-3 text-ink-700 leading-relaxed">{i.texte}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8 text-base text-ink-600">
        D'autres modèles et finitions sont présentés dans notre showroom de
        Normanville.{" "}
        <a href={url("/contact")} class="text-brand-600 hover:text-brand-700 font-semibold underline-offset-4 hover:underline">
          Venez les voir de près
        </a>.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos réalisations
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Des cheminées posées près de chez vous
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          Toutes nos cheminées sont conçues, fabriquées et installées pour de vrais
          intérieurs de l'Eure et de Normandie. En voici un aperçu.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {galerie.map((g) => (
          <figure class="overflow-hidden rounded-xl bg-white border border-warm-100">
            <img
              src={url(g.image)}
              alt={g.alt}
              width="600"
              height="450"
              loading="lazy"
              class="w-full aspect-[4/3] object-cover"
            />
          </figure>
        ))}
      </div>

      <div class="mt-9">
        <a
          href={url("/galerie")}
          class="inline-flex items-center gap-2 text-base font-semibold text-brand-600 hover:text-brand-700 transition"
        >
          Voir toutes nos réalisations
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
        <div class="flex items-start gap-3">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-50 text-brand-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </span>
          <div>
            <p class="font-bold text-ink-900">Fabrication française</p>
            <p class="mt-1 text-sm text-ink-600 leading-relaxed">Modèles Cheminées Philippe fabriqués en France depuis 1961.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-50 text-brand-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </span>
          <div>
            <p class="font-bold text-ink-900">Pose par nos équipes</p>
            <p class="mt-1 text-sm text-ink-600 leading-relaxed">Installation clé en main et SAV local, concessionnaire depuis 1986.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-50 text-brand-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 2H21l-3 6 3 6h-8.5l-1-2H5a2 2 0 00-2 2zm9-13.5V9"/>
            </svg>
          </span>
          <div>
            <p class="font-bold text-ink-900">RGE Qualibois</p>
            <p class="mt-1 text-sm text-ink-600 leading-relaxed">Certifié Flamme Verte — un gage de qualité et d'éligibilité aux aides.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA
    heading="Parlons de votre cheminée"
    description="Un conseiller se déplace gratuitement, prend les mesures et dessine avec vous le projet adapté à votre pièce. Devis sous 48 h."
  />
</BaseLayout>

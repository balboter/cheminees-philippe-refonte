---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import Manifeste from "../components/Manifeste.astro";
import ProjetTroisTemps from "../components/ProjetTroisTemps.astro";
import MatieresSavoirFaire from "../components/MatieresSavoirFaire.astro";
import Realisations from "../components/Realisations.astro";
import CTA from "../components/CTA.astro";
import { url } from "../lib/url";

const temps = [
  {
    titre: "La conception, chez vous",
    texte:
      "Tout commence par une visite. Le conseiller mesure la pièce, observe la lumière du matin et du soir, repère la place du conduit, écoute la façon dont vous habitez l'espace. C'est de cette conversation que naît le dessin de votre cheminée.",
  },
  {
    titre: "La fabrication, en atelier",
    texte:
      "Le projet rejoint les ateliers Cheminées Philippe. Là, la pierre est taillée, la fonte coulée, le marbre poli, le fer forgé. Chaque pièce est façonnée pour votre habillage, à vos dimensions — pas à celles d'un catalogue.",
  },
  {
    titre: "La pose, par nos équipes",
    texte:
      "Nos techniciens installent la cheminée, raccordent le conduit aux normes, ajustent les finitions. Le jour de la mise en service, ils allument le premier feu avec vous et vous expliquent comment en prendre soin.",
  },
];

const matieres = [
  {
    nom: "Pierre bleue",
    legende:
      "La pierre bleue du Hainaut, dense et veinée, pour les cheminées qui veulent une présence sobre et durable.",
  },
  {
    nom: "Fonte",
    legende:
      "Le cœur de l'appareil : la fonte accumule la chaleur et la restitue longtemps après la flambée.",
  },
  {
    nom: "Marbre",
    legende:
      "Tablettes et encadrements taillés et polis à la marbrerie, pour la finition qui transforme un foyer en cheminée.",
  },
  {
    nom: "Ferronnerie",
    legende:
      "Linteaux et détails forgés à la main : ce qui donne son caractère à une cheminée, sans jamais l'alourdir.",
  },
];

const inspirations = [
  {
    image: "/images/installations/167.webp",
    alt: "Cheminée d'inspiration classique en pierre de taille, foyer central",
    style: "Inspiration classique",
    titre: "La cheminée de toujours, revisitée",
    texte:
      "Pierre franche, proportions généreuses, foyer central. La cheminée à laquelle on pense d'instinct — à laquelle Cheminées Philippe ajoute les rendements d'aujourd'hui.",
  },
  {
    image: "/images/installations/183.webp",
    alt: "Cheminée contemporaine au foyer largement vitré dans une pièce ouverte",
    style: "Inspiration contemporaine",
    titre: "Quand la flamme devient le seul ornement",
    texte:
      "Lignes épurées, large vitre, habillage discret. La cheminée contemporaine s'efface pour laisser toute la place au feu et à la pièce.",
  },
];

const realisations = [
  {
    image: "/images/installations/166.webp",
    alt: "Cheminée habillée de marbre clair installée dans un salon",
    legende: "Habillage de marbre clair",
    lieu: "Vernon",
  },
  {
    image: "/images/installations/178.webp",
    alt: "Cheminée d'angle sur mesure intégrée dans une pièce de vie",
    legende: "Cheminée d'angle sur mesure",
    lieu: "Louviers",
  },
  {
    image: "/images/installations/196.webp",
    alt: "Cheminée maçonnée sur mesure habillée de pierre",
    legende: "Habillage de pierre maçonné",
    lieu: "Gisors",
  },
];
---

<BaseLayout
  title="Cheminées sur mesure Cheminées Philippe — Évreux & Normandie"
  description="Une cheminée sur mesure dessinée pour votre pièce, fabriquée en France par Cheminées Philippe et posée dans l'Eure par nos équipes. Devis et visite gratuits."
>
  <HeroEditorial
    kicker="Cheminées sur mesure"
    title="Une cheminée pensée pour cette pièce, et pour aucune autre"
    intro="Le sur-mesure n'ajoute pas de la complexité. Il enlève le hasard. Votre cheminée part de votre pièce, de vos murs, de votre lumière — puis elle est façonnée pour eux."
    image="/images/installations/178.webp"
    imageAlt="Cheminée d'angle sur mesure installée dans un séjour, le feu allumé"
    ctaLabel="Échanger sur votre projet"
    ctaHref="/contact"
  />

  <Manifeste
    kicker="Qu'est-ce qu'une cheminée sur mesure"
    title="Ni un meuble que l'on pose, ni un produit que l'on choisit"
    paragraphs={[
      "Une cheminée de catalogue arrive avec ses dimensions. À vous de trouver le mur qui les accepte. Une cheminée sur mesure fait l'inverse : c'est elle qui s'ajuste à votre pièce.",
      "Chez Cheminées Philippe, le sur-mesure n'est pas une option. C'est le métier même de la maison : une fonderie, une marbrerie et une ferronnerie réunies au même endroit, capables de façonner chaque habillage à la demande.",
      "Le résultat n'est pas un appareil ajouté à votre salon. C'est une pièce qui semble avoir toujours été là.",
    ]}
  />

  <ProjetTroisTemps
    kicker="Le sur-mesure expliqué"
    title="De la conception au premier feu"
    intro="Trois temps, un seul interlocuteur, du croquis à la flambée."
    temps={temps}
    variant="cream"
  />

  <section class="bg-white py-20 sm:py-28 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-600">
          Inspirations & styles
        </p>
        <h2 class="mt-5 font-display font-semibold text-ink-900 leading-[1.12] text-3xl sm:text-4xl lg:text-5xl">
          Deux esprits, un même soin
        </h2>
        <p class="mt-5 text-lg text-ink-600 leading-relaxed">
          Classique ou contemporaine, votre cheminée part toujours d'un dessin que
          nous adaptons à votre pièce. Voici deux points de départ.
        </p>
      </div>

      <div class="mt-12 sm:mt-16 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
        {inspirations.map((i) => (
          <article class="group">
            <div class="overflow-hidden">
              <img
                src={url(i.image)}
                alt={i.alt}
                width="900"
                height="675"
                loading="lazy"
                class="w-full aspect-[4/3] object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.04]"
              />
            </div>
            <p class="mt-6 text-xs uppercase tracking-[0.24em] text-brand-600">
              {i.style}
            </p>
            <h3 class="mt-2 font-display text-2xl sm:text-3xl text-ink-900 leading-snug">
              {i.titre}
            </h3>
            <p class="mt-3 text-lg text-ink-600 leading-relaxed">{i.texte}</p>
          </article>
        ))}
      </div>

      <p class="mt-12 text-ink-600 leading-relaxed max-w-2xl">
        D'autres modèles, finitions et matières sont présentés dans notre showroom
        de Normanville.{" "}
        <a
          href={url("/contact")}
          class="text-brand-600 hover:text-brand-700 underline underline-offset-4"
        >
          Venez les voir de près
        </a>.
      </p>
    </div>
  </section>

  <MatieresSavoirFaire
    kicker="Matières & savoir-faire"
    title="La cheminée se juge à la matière"
    intro="Pierre, fonte, marbre, fer : ce sont les matières qui font qu'une cheminée se regarde longtemps. Toutes sont travaillées en atelier, à la main."
    image="/images/installations/166.webp"
    imageAlt="Gros plan sur l'habillage de pierre et de marbre d'une cheminée Cheminées Philippe"
    matieres={matieres}
    variant="cream"
  />

  <Realisations
    kicker="Réalisations"
    title="Des cheminées posées près de chez vous"
    intro="Conçues, fabriquées et installées pour de vrais intérieurs de l'Eure et de Normandie."
    items={realisations}
    lienLabel="Voir toutes nos réalisations"
    lienHref="/realisations"
    variant="white"
  />

  <CTA
    kicker="Parlons-en"
    heading="Et si votre cheminée prenait forme ?"
    description="Un conseiller se déplace gratuitement, prend les mesures et dessine avec vous le projet adapté à votre pièce."
  />
</BaseLayout>

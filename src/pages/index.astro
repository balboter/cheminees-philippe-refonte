---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import Manifeste from "../components/Manifeste.astro";
import Realisations from "../components/Realisations.astro";
import MatieresSavoirFaire from "../components/MatieresSavoirFaire.astro";
import ProjetTroisTemps from "../components/ProjetTroisTemps.astro";
import Showroom from "../components/Showroom.astro";
import { url } from "../lib/url";

const realisations = [
  {
    image: "/images/installations/167.webp",
    alt: "Cheminée en pierre de taille dessinée et installée par Cheminées Philippe dans un séjour normand",
    legende: "Pierre de taille, séjour de famille",
    lieu: "Bernay",
  },
  {
    image: "/images/installations/183.webp",
    alt: "Cheminée contemporaine au foyer largement vitré dans une pièce de vie ouverte",
    legende: "Lignes contemporaines, pièce ouverte",
    lieu: "Louviers",
  },
  {
    image: "/images/installations/166.webp",
    alt: "Cheminée habillée de marbre clair, tablette polie en atelier",
    legende: "Habillage de marbre clair",
    lieu: "Vernon",
  },
];

const matieres = [
  {
    nom: "Pierre bleue",
    legende:
      "La pierre bleue du Hainaut, dense et profonde, donne à une cheminée son poids et sa présence tranquille.",
  },
  {
    nom: "Fonte",
    legende:
      "Coulée en fonderie, la fonte emmagasine la chaleur de la flambée et la rend longtemps après les dernières braises.",
  },
  {
    nom: "Marbre",
    legende:
      "Tablettes et jambages sont taillés et polis à la marbrerie, jusqu'à ce que la lumière y glisse sans accroc.",
  },
  {
    nom: "Ferronnerie",
    legende:
      "Linteaux et contrecœurs forgés à la main : la part de caractère, celle qui se remarque sans se montrer.",
  },
  {
    nom: "Céramique & émail",
    legende:
      "Surfaces émaillées et céramiques apportent la couleur et la douceur du toucher, cuites pour durer.",
  },
];

const temps = [
  {
    titre: "On dessine avec vous",
    texte:
      "Un conseiller vient chez vous. Il regarde la pièce, la lumière, la place du conduit, la manière dont vous vivez l'espace. De cette visite naît un projet pensé pour cet endroit précis — pas un modèle posé au hasard.",
  },
  {
    titre: "L'atelier façonne la cheminée",
    texte:
      "Le projet part chez Cheminées Philippe, fabricant français depuis 1961. Fonderie, marbrerie et ferronnerie travaillent la matière, pièce après pièce, jusqu'à ce que votre cheminée existe vraiment.",
  },
  {
    titre: "Nos équipes la posent",
    texte:
      "Nos techniciens installent la cheminée chez vous, soignent chaque raccord et chaque finition, puis allument le premier feu avec vous. Un seul interlocuteur, du premier croquis à la première flambée.",
  },
];
---

<BaseLayout
  title="Cheminées Philippe Évreux — cheminées sur mesure depuis 1986"
  description="Cheminées sur mesure conçues, fabriquées en France et installées dans l'Eure par votre concessionnaire Cheminées Philippe depuis 1986. Foyers et inserts."
>
  <HeroEditorial
    kicker="Cheminées sur mesure · Eure & Normandie"
    title="Votre cheminée, dessinée pour votre pièce"
    intro="Une cheminée n'est pas un appareil que l'on choisit dans un catalogue. C'est une pièce conçue pour votre intérieur, façonnée dans les ateliers Cheminées Philippe, posée chez vous par nos équipes."
    image="/images/installations/167.webp"
    imageAlt="Cheminée sur mesure en pierre installée dans un séjour, le feu allumé"
    ctaLabel="Échanger sur votre projet"
    ctaHref="/contact"
  />

  <Manifeste
    kicker="Le sur-mesure"
    title="Depuis 1986, nous donnons une forme au feu"
    paragraphs={[
      "Loisirs Habitat Diffusion est concessionnaire Cheminées Philippe depuis 1986. Notre métier tient en une idée simple : faire entrer une vraie cheminée dans votre maison, et qu'elle en devienne le cœur.",
      "Cheminées Philippe fabrique en France depuis 1961. Sous un même toit : une fonderie, une marbrerie, une ferronnerie, un atelier de céramique. C'est cette réunion rare de métiers qui rend le sur-mesure possible — et qui sépare une cheminée d'un simple foyer.",
      "Nous ne vendons pas un produit. Nous accompagnons un projet, du premier croquis posé sur votre table jusqu'au soir où vous allumez le premier feu.",
    ]}
    signature="Loisirs Habitat Diffusion — concessionnaire Cheminées Philippe, Normanville"
  />

  <Realisations
    kicker="Réalisations"
    title="Des cheminées qui ont trouvé leur pièce"
    intro="Chaque image est une installation réelle, chez un particulier de l'Eure ou de Normandie. Aucune n'a son double."
    items={realisations}
    lienLabel="Voir toutes nos réalisations"
    lienHref="/realisations"
    variant="white"
  />

  <MatieresSavoirFaire
    kicker="Matières & savoir-faire"
    title="Cinq métiers réunis dans une cheminée"
    intro="La beauté d'une cheminée tient à ses matières et à la main qui les travaille. Voici celles que la maison Cheminées Philippe façonne en atelier."
    image="/images/installations/166.webp"
    imageAlt="Détail d'une cheminée Cheminées Philippe : habillage de pierre et tablette de marbre"
    matieres={matieres}
    variant="cream"
  />

  <ProjetTroisTemps
    kicker="Le projet, de l'idée au feu"
    title="Trois temps, un seul interlocuteur"
    intro="Le sur-mesure n'est pas plus compliqué qu'un modèle standard. Il est seulement plus juste. Voici comment se déroule un projet chez nous."
    temps={temps}
    variant="white"
  />

  <Showroom
    kicker="Le showroom"
    title="Venez voir le feu à Normanville"
    intro="Rien ne remplace une cheminée vue en vrai : la flamme, la matière, les proportions. Notre showroom de Normanville, à quelques minutes d'Évreux, présente cheminées, foyers et poêles dans des ambiances de vrai salon."
    image="/images/installations/178.webp"
    imageAlt="Cheminée d'angle présentée dans le showroom Cheminées Philippe de Normanville"
    variant="cream"
  />

  <section class="relative isolate overflow-hidden">
    <img
      src={url("/images/installations/137.webp")}
      alt=""
      width="1920"
      height="1080"
      loading="lazy"
      aria-hidden="true"
      class="absolute inset-0 -z-10 w-full h-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-ink-950/80" aria-hidden="true"></div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40 text-center">
      <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-300">
        Contact
      </p>
      <h2 class="mt-6 font-display font-semibold text-white leading-[1.14] text-3xl sm:text-4xl lg:text-5xl">
        Parlons de la vôtre
      </h2>
      <p class="mt-6 text-lg text-warm-100/90 leading-relaxed">
        Décrivez-nous votre projet en quelques lignes, ou appelez simplement le
        showroom. La visite technique et le devis sont gratuits, sans engagement.
      </p>

      <div class="mt-10 flex flex-col items-center gap-5">
        <a
          href={url("/contact")}
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition-colors duration-300"
        >
          Échanger sur votre projet
        </a>
        <a
          href="tel:+33232333193"
          class="inline-flex items-center gap-2 text-white font-display text-2xl sm:text-3xl hover:text-brand-300 transition-colors duration-300"
        >
          <svg class="w-6 h-6 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 33 31 93
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

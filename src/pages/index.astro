---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import BandeauConfiance from "../components/BandeauConfiance.astro";
import NosSolutions from "../components/NosSolutions.astro";
import Realisations from "../components/Realisations.astro";
import ProjetTroisTemps from "../components/ProjetTroisTemps.astro";
import PourquoiNous from "../components/PourquoiNous.astro";
import { url } from "../lib/url";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const mapsHref =
  "https://www.google.com/maps/dir/?api=1&destination=Centre%20commercial%20Caer%2C%2027930%20Normanville";

const solutions = [
  {
    image: "/images/installations/167.webp",
    alt: "Cheminée sur mesure en pierre installée par Cheminées Philippe dans un séjour",
    titre: "Cheminées sur mesure",
    texte:
      "Une cheminée dessinée pour votre pièce, fabriquée en France et posée par nos équipes. Le projet complet, clé en main.",
    href: "/cheminees-sur-mesure",
    lien: "Voir les cheminées sur mesure",
  },
  {
    image: "/images/installations/137.webp",
    alt: "Foyer fermé à grande vitre installé dans une cheminée",
    titre: "Foyers & inserts",
    texte:
      "Rénovez une cheminée à foyer ouvert : un foyer fermé ou un insert chauffe vraiment et reste éligible aux aides.",
    href: "/foyers-inserts",
    lien: "Voir les foyers & inserts",
  },
  {
    image: "/images/installations/149.webp",
    alt: "Foyer fermé installé dans une pièce de vie d'un pavillon",
    titre: "Poêles à bois & granulés",
    texte:
      "Une solution rapide à installer, sans gros travaux. Bois ou granulés : nous vous orientons selon votre maison.",
    href: "/poeles",
    lien: "Voir les poêles",
  },
];

const realisations = [
  {
    image: "/images/installations/167.webp",
    alt: "Cheminée en pierre de taille installée par Cheminées Philippe dans un séjour normand",
    legende: "Cheminée en pierre de taille",
    lieu: "Bernay",
  },
  {
    image: "/images/installations/183.webp",
    alt: "Cheminée contemporaine au foyer largement vitré dans une pièce de vie ouverte",
    legende: "Foyer fermé, pièce ouverte",
    lieu: "Louviers",
  },
  {
    image: "/images/installations/166.webp",
    alt: "Cheminée habillée de marbre clair installée dans un salon",
    legende: "Habillage de marbre clair",
    lieu: "Vernon",
  },
];

const temps = [
  {
    titre: "La visite-conseil, gratuite",
    texte:
      "Un conseiller se déplace chez vous. Il mesure la pièce, repère la place du conduit, écoute votre besoin — puis vous remet un devis clair et chiffré. Sans engagement.",
  },
  {
    titre: "La conception sur mesure",
    texte:
      "Votre projet est dessiné pour votre pièce et fabriqué en France par Cheminées Philippe. Vous validez les matières, les dimensions et le rendu avant tout démarrage.",
  },
  {
    titre: "L'installation par nos équipes",
    texte:
      "Nos techniciens salariés posent l'appareil, raccordent le conduit aux normes et allument le premier feu avec vous. Un seul interlocuteur, du devis au SAV.",
  },
];

const atouts = [
  {
    titre: "Des équipes internes, pas de sous-traitance",
    texte:
      "Conseillers et poseurs sont salariés de l'entreprise. La même maison vous suit du premier rendez-vous à la mise en service.",
  },
  {
    titre: "Un SAV qui répond après la pose",
    texte:
      "Entretien, ramonage, pièces : une fois le feu allumé, vous nous rappelez directement. Nous restons votre interlocuteur.",
  },
  {
    titre: "Un savoir-faire français reconnu",
    texte:
      "Fonderie, marbrerie, ferronnerie, céramique : Cheminées Philippe réunit ces métiers depuis 1961. C'est ce qui rend le vrai sur-mesure possible.",
  },
];
---

<BaseLayout
  title="Cheminées Philippe Évreux — devis cheminée gratuit"
  description="Cheminées sur mesure, foyers, inserts et poêles installés dans l'Eure par votre concessionnaire Cheminées Philippe depuis 1986. Visite-conseil gratuite."
>
  <HeroEditorial
    kicker="Cheminées · Foyers · Inserts · Poêles — Eure & Normandie"
    title="Votre cheminée installée clé en main, sans mauvaise surprise"
    intro="Conception, fabrication française et pose par nos équipes : un seul interlocuteur, du devis au premier feu. Demandez votre devis gratuit dès aujourd'hui."
    image="/images/installations/167.webp"
    imageAlt="Cheminée sur mesure en pierre installée dans un séjour, le feu allumé"
    ctaLabel="Demander un devis gratuit"
    ctaHref="/contact"
    reassurance="Visite-conseil offerte à domicile — concessionnaire Cheminées Philippe depuis 1986."
  />

  <BandeauConfiance />

  <NosSolutions
    kicker="Nos solutions"
    title="Quel projet de feu pour votre maison ?"
    intro="Cheminée neuve, rénovation d'un foyer ouvert ou poêle d'appoint : choisissez le point de départ. Notre conseiller affine ensuite avec vous lors de la visite."
    solutions={solutions}
    variant="white"
  />

  <Realisations
    kicker="Nos réalisations"
    title="Des installations réelles, près de chez vous"
    intro="Chaque photo est un chantier que nous avons mené chez un particulier de l'Eure ou de Normandie. La meilleure preuve de ce que nous savons faire."
    items={realisations}
    lienLabel="Voir toutes nos réalisations"
    lienHref="/realisations"
    variant="cream"
  />

  <ProjetTroisTemps
    kicker="Votre projet en 3 étapes"
    title="De la visite-conseil au premier feu"
    intro="Un projet de cheminée est plus simple qu'il n'y paraît. Voici comment cela se déroule chez nous — et la première étape ne vous coûte rien."
    temps={temps}
    variant="white"
    ctaLabel="Demander un devis gratuit"
    ctaHref="/contact"
  />

  <PourquoiNous
    kicker="Pourquoi nous choisir"
    title="Un seul interlocuteur, du devis au premier feu"
    intro="Vous ne jonglez pas entre un vendeur, un poseur et un fabricant. Une seule maison conçoit, fait fabriquer et installe — et reste joignable ensuite."
    image="/images/installations/166.webp"
    imageAlt="Détail d'une cheminée Cheminées Philippe : habillage de pierre et tablette de marbre"
    atouts={atouts}
    variant="warm"
  />

  <section id="contact" class="bg-white py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16">
        <div>
          <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
            Demander un devis gratuit
          </p>
          <h2 class="mt-4 font-display font-semibold text-ink-900 leading-[1.14] text-3xl sm:text-4xl">
            Décrivez votre projet en 1 minute
          </h2>
          <p class="mt-4 text-lg text-ink-600 leading-relaxed">
            Quatre informations suffisent. Un conseiller vous rappelle pour
            préciser votre projet et organiser la visite-conseil gratuite.
          </p>

          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5">
            {[
              "Réponse sous 48 h ouvrées",
              "Devis gratuit et sans engagement",
              "Visite-conseil offerte à domicile",
            ].map((point) => (
              <li class="flex items-center gap-2 text-ink-700">
                <svg class="w-5 h-5 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>

          <form
            id="devis-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="mt-9 space-y-6"
          >
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="Demande de devis — Cheminées Philippe (accueil)" />
            <input type="hidden" name="from_name" value="Site Cheminées Philippe" />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="nom" class="block text-sm font-semibold text-ink-900">
                  Nom complet <span class="text-brand-500" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="nom"
                  name="nom"
                  required
                  aria-required="true"
                  autocomplete="name"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                />
              </div>
              <div>
                <label for="telephone" class="block text-sm font-semibold text-ink-900">
                  Téléphone <span class="text-brand-500" aria-hidden="true">*</span>
                </label>
                <input
                  type="tel"
                  id="telephone"
                  name="telephone"
                  required
                  aria-required="true"
                  autocomplete="tel"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-ink-900">
                Email <span class="text-brand-500" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                aria-required="true"
                autocomplete="email"
                class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
              />
            </div>

            <div>
              <label for="type-projet" class="block text-sm font-semibold text-ink-900">
                Type de projet <span class="text-brand-500" aria-hidden="true">*</span>
              </label>
              <select
                id="type-projet"
                name="type_projet"
                required
                aria-required="true"
                class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
              >
                <option value="">— Sélectionnez —</option>
                <option value="Cheminée sur mesure">Cheminée sur mesure</option>
                <option value="Foyer fermé">Foyer fermé</option>
                <option value="Insert (rénovation)">Insert (rénovation)</option>
                <option value="Poêle à bois">Poêle à bois</option>
                <option value="Poêle à granulés">Poêle à granulés</option>
                <option value="Je ne sais pas encore">Je ne sais pas encore</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-ink-900">
                Votre projet en quelques mots
                <span class="text-ink-500 font-normal">(facultatif)</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="La pièce, un conduit existant ou non, un délai souhaité…"
                class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
              ></textarea>
            </div>

            <p class="text-sm text-ink-500 leading-relaxed">
              Vos informations servent uniquement à vous recontacter et sont
              conservées 3 ans après le dernier échange. Voir notre{" "}
              <a
                href={url("/politique-de-confidentialite")}
                class="underline text-brand-500 hover:text-brand-600"
              >
                politique de confidentialité
              </a>.
            </p>

            <button
              type="submit"
              id="submit-btn"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-md bg-brand-500 text-white text-lg font-bold hover:bg-brand-600 transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="submit-label">Demander mon devis gratuit</span>
              <svg id="submit-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

          <div id="form-success" class="hidden mt-8 p-7 rounded-2xl bg-warm-50 border border-brand-200">
            <h3 class="font-display text-xl text-ink-900">Demande reçue, merci.</h3>
            <p class="mt-2 text-ink-600 leading-relaxed">
              Un conseiller vous rappelle sous 48 h ouvrées. Pour nous joindre tout
              de suite, appelez le{" "}
              <a href="tel:+33232333193" class="font-semibold text-brand-500 hover:text-brand-600">
                02 32 33 31 93
              </a>.
            </p>
          </div>

          <div id="form-error" class="hidden mt-8 p-7 rounded-2xl bg-warm-50 border border-brand-300">
            <h3 class="font-display text-xl text-ink-900">L'envoi a échoué.</h3>
            <p class="mt-2 text-ink-600 leading-relaxed">
              Un problème technique nous empêche de recevoir votre demande. Merci
              de nous appeler au{" "}
              <a href="tel:+33232333193" class="font-semibold text-brand-500 hover:text-brand-600">
                02 32 33 31 93
              </a>{" "}
              ou de nous écrire à{" "}
              <a href="mailto:cheminexpo@wanadoo.fr" class="font-semibold text-brand-500 hover:text-brand-600">
                cheminexpo@wanadoo.fr
              </a>.
            </p>
          </div>
        </div>

        <aside class="lg:pl-4">
          <div class="rounded-xl border border-warm-100 bg-warm-50 p-7 sm:p-8">
            <p class="text-xs uppercase tracking-[0.2em] text-ink-500">
              Vous préférez appeler ?
            </p>
            <a
              href="tel:+33232333193"
              class="block mt-2 font-display text-3xl sm:text-4xl text-ink-900 hover:text-brand-600 transition-colors duration-300"
            >
              02 32 33 31 93
            </a>
            <p class="mt-3 text-ink-600 leading-relaxed">
              Du mardi au vendredi 9h-12h / 14h-18h, le samedi 10h-12h / 14h-18h.
            </p>

            <div class="mt-7 pt-7 border-t border-warm-200">
              <p class="text-xs uppercase tracking-[0.2em] text-ink-500">
                Notre showroom
              </p>
              <address class="mt-2 not-italic text-ink-800 leading-relaxed">
                Centre commercial Caer, Route de Rouen<br />
                27930 Normanville<br />
                <span class="text-ink-500">à quelques minutes d'Évreux</span>
              </address>
              <a
                href={mapsHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group mt-4 inline-flex items-center gap-2 font-semibold text-brand-500 hover:text-brand-600 transition-colors duration-300"
              >
                Ouvrir l'itinéraire<span class="sr-only"> (ouvre dans un nouvel onglet)</span>
                <span
                  class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </div>

            <div class="mt-7 pt-7 border-t border-warm-200">
              <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Par email</p>
              <a
                href="mailto:cheminexpo@wanadoo.fr"
                class="block mt-2 font-display text-lg text-ink-900 hover:text-brand-600 transition-colors duration-300 break-all"
              >
                cheminexpo@wanadoo.fr
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.getElementById("devis-form");
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");
  const submitLabel = document.getElementById("submit-label");
  const submitSpinner = document.getElementById("submit-spinner");

  function restoreSubmit() {
    if (!submitBtn) return;
    submitBtn.disabled = false;
    submitLabel.textContent = "Demander mon devis gratuit";
    submitSpinner.classList.add("hidden");
  }

  async function submitForm(e) {
    e.preventDefault();

    if (form && !form.checkValidity()) {
      form.reportValidity();
      return;
    }

    successEl.classList.add("hidden");
    errorEl.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitLabel.textContent = "Envoi en cours...";
      submitSpinner.classList.remove("hidden");
    }

    const formData = new FormData(form);
    const accessKey = formData.get("access_key");

    if (!accessKey || accessKey === "") {
      restoreSubmit();
      errorEl.classList.remove("hidden");
      errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });
      const json = await res.json();

      if (json.success) {
        form.style.display = "none";
        successEl.classList.remove("hidden");
        successEl.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        throw new Error(json.message || "Erreur inconnue");
      }
    } catch (err) {
      restoreSubmit();
      errorEl.classList.remove("hidden");
      errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  form?.addEventListener("submit", submitForm);
</script>
</content>

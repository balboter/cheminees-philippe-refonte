---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { url } from "../lib/url";

const savoirFaire = [
  {
    titre: "La fonderie",
    desc: "Les foyers et inserts sont coulés en fonte, un matériau qui accumule la chaleur et la restitue longtemps après l'extinction du feu.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3c0 4-3 5-3 9a3 3 0 006 0c0-4-3-5-3-9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 21h14"/></svg>',
  },
  {
    titre: "La ferronnerie",
    desc: "Habillages, contre-cœurs et éléments décoratifs sont travaillés à la main. C'est ce qui donne à chaque cheminée son caractère.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4l9 9-2 2-9-9zM4 11l5 5-3 3a2 2 0 01-3-3l1-5z"/></svg>',
  },
  {
    titre: "La marbrerie",
    desc: "Pierre et marbre sont taillés pour épouser votre pièce. Un habillage qui s'intègre, jamais un meuble que l'on pose.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7l8-4 8 4-8 4-8-4z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10l8 4 8-4V7"/></svg>',
  },
];

const equipe = [
  {
    role: "Conseil & visite technique",
    desc: "Nos conseillers vous reçoivent au showroom et se déplacent chez vous pour étudier la pièce, le conduit et vos besoins. Ce sont eux qui dessinent votre projet.",
  },
  {
    role: "Installation",
    desc: "Nos poseurs sont salariés de l'entreprise. Pas de sous-traitance : la même équipe assure la pose, le raccordement et la mise en service.",
  },
  {
    role: "Suivi & SAV",
    desc: "Après l'installation, nous restons votre interlocuteur. Entretien, ramonage, pièces : vous nous rappelez directement, sans hotline anonyme.",
  },
];

const certifications = [
  {
    titre: "RGE Qualibois",
    desc: "La qualification reconnue par l'État pour les installateurs d'appareils au bois. Elle conditionne l'accès à MaPrimeRénov' et aux CEE pour votre projet.",
  },
  {
    titre: "Flamme Verte",
    desc: "Le label qui distingue les appareils les plus performants et les plus propres. Les modèles Cheminées Philippe que nous posons en sont équipés.",
  },
  {
    titre: "Fabrication française",
    desc: "Les appareils que nous installons sont fabriqués en France par Cheminées Philippe, dans ses ateliers de fonderie, ferronnerie et marbrerie.",
  },
];
---

<BaseLayout
  title="Concessionnaire Cheminées Philippe à Normanville — Évreux"
  description="Concessionnaire Cheminées Philippe depuis 1986 à Normanville (Eure). Showroom, équipe locale, certifiés RGE Qualibois et Flamme Verte."
>
  <section class="bg-warm-100 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Notre maison
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ink-900">
        Concessionnaire Cheminées Philippe<br class="hidden sm:block" /> depuis 1986
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-ink-700 max-w-3xl leading-relaxed">
        Installés à Normanville, près d'Évreux, nous accompagnons les familles de
        l'Eure dans le choix et la pose de leur cheminée, de leur insert ou de leur
        poêle. Notre métier : transformer une belle idée en un feu qui chauffe
        vraiment, pendant des années.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-warm-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-900">
        Une concession ancrée dans l'Eure
      </h2>
      <div class="mt-6 space-y-5 text-lg text-ink-700 leading-relaxed">
        <p>
          La société Loisirs Habitat Diffusion a ouvert son showroom à Normanville
          en 1986. Depuis, nous faisons le même métier : conseiller, installer et
          suivre des cheminées et des poêles chez les particuliers de la région.
        </p>
        <p>
          Nous sommes <strong>concessionnaire de la marque Cheminées Philippe</strong>.
          Concrètement : nous distribuons et nous installons ses appareils, mais
          nous ne les fabriquons pas. La fabrication, c'est l'affaire de Cheminées
          Philippe, un fabricant français que nous vous présentons juste après.
        </p>
        <p>
          Ce double rôle est notre force. Vous bénéficiez d'un produit fabriqué en
          France et d'un interlocuteur local qui connaît votre secteur, vos maisons
          normandes et qui reste joignable une fois le feu allumé.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Le fabricant
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          L'artisanat Cheminées Philippe
        </h2>
        <p class="mt-5 text-lg text-ink-700 leading-relaxed">
          Cheminées Philippe est un fabricant français né en 1961. Sa particularité :
          réunir sous le même toit la fonderie, la ferronnerie et la marbrerie.
          Trois savoir-faire d'atelier qui font de chaque appareil un objet pensé
          pour durer.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {savoirFaire.map((s) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-warm-50 border border-warm-100">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-brand-500 text-white">
              <span set:html={s.icon} />
            </div>
            <h3 class="mt-5 text-xl font-bold text-ink-900">{s.titre}</h3>
            <p class="mt-3 text-base text-ink-700 leading-relaxed">{s.desc}</p>
          </article>
        ))}
      </div>

      <p class="mt-8 text-base text-ink-600 leading-relaxed max-w-3xl">
        C'est cet artisanat que nous mettons à votre service. Une cheminée sur
        mesure n'est pas un produit de catalogue : elle est dessinée pour votre
        pièce, puis fabriquée pour elle.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Notre équipe
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Une installation par nos propres équipes
        </h2>
        <p class="mt-5 text-lg text-ink-700 leading-relaxed">
          Du premier conseil au dernier réglage, vous avez affaire à la même
          maison. C'est notre engagement le plus simple, et le plus important.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {equipe.map((m, i) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-white border border-warm-100">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-brand-500 text-white font-bold">
              {i + 1}
            </span>
            <h3 class="mt-4 text-xl font-bold text-ink-900">{m.role}</h3>
            <p class="mt-3 text-base text-ink-700 leading-relaxed">{m.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos garanties
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Des certifications qui comptent
        </h2>
        <p class="mt-5 text-lg text-ink-700 leading-relaxed">
          Au-delà du savoir-faire, ces qualifications protègent votre projet et
          ouvrent l'accès aux aides de l'État.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {certifications.map((c) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-warm-50 border border-warm-100">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="mt-5 text-xl font-bold text-ink-900">{c.titre}</h3>
            <p class="mt-3 text-base text-ink-700 leading-relaxed">{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        <div>
          <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-brand-500"></span>
            Le showroom
          </p>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
            Venez voir le feu à Normanville
          </h2>
          <p class="mt-5 text-lg text-ink-700 leading-relaxed">
            Rien ne remplace le fait de voir un appareil en vrai : la flamme, la
            matière, les dimensions. Notre showroom de Normanville, à quelques
            minutes d'Évreux, présente cheminées, inserts et poêles dans des
            ambiances proches d'un vrai salon.
          </p>

          <dl class="mt-8 space-y-5">
            <div class="flex gap-3">
              <svg class="w-6 h-6 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <dt class="font-bold text-ink-900">Adresse</dt>
                <dd class="text-ink-700">
                  <address class="not-italic">
                    Centre commercial Caer, Route de Rouen<br />
                    27930 Normanville
                  </address>
                </dd>
              </div>
            </div>

            <div class="flex gap-3">
              <svg class="w-6 h-6 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="font-bold text-ink-900">Horaires</dt>
                <dd class="text-ink-700">
                  Mardi à vendredi : 9h-12h / 14h-18h<br />
                  Samedi : 10h-12h / 14h-18h<br />
                  Fermé dimanche et lundi
                </dd>
              </div>
            </div>

            <div class="flex gap-3">
              <svg class="w-6 h-6 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div>
                <dt class="font-bold text-ink-900">Téléphone</dt>
                <dd>
                  <a href="tel:+33232333193" class="text-brand-600 hover:text-brand-700 font-bold text-lg">
                    02 32 33 31 93
                  </a>
                </dd>
              </div>
            </div>
          </dl>

          <a
            href={url("/contact")}
            class="mt-8 inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
          >
            Préparer votre visite
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15" />
            </svg>
          </a>
        </div>

        <div class="rounded-2xl border border-warm-100 bg-white shadow-md p-6 sm:p-8">
          <h3 class="text-xl font-bold text-ink-900 leading-tight">
            Le showroom, sur le plan
          </h3>
          <p class="mt-3 text-base text-ink-700 leading-relaxed">
            Notre magasin se trouve au Centre commercial Caer, Route de Rouen à
            Normanville, à une dizaine de minutes d'Évreux. Ouvrez l'itinéraire
            pour le rejoindre depuis chez vous.
          </p>
          <address class="mt-5 not-italic text-base text-ink-700 leading-relaxed">
            Centre commercial Caer, Route de Rouen<br />
            27930 Normanville
          </address>
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=Centre%20commercial%20Caer%2C%2027930%20Normanville"
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-6 flex items-center justify-between gap-3 p-5 rounded-xl bg-warm-50 border border-warm-100 hover:border-brand-300 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
          >
            <span class="flex items-center gap-3">
              <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-500 text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <span class="font-semibold text-ink-900">Itinéraire vers le showroom</span>
            </span>
            <svg class="w-5 h-5 text-brand-600 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA
    heading="Parlons de votre projet"
    description="Que vous rêviez d'une cheminée sur mesure ou que vous hésitiez encore entre bois et granulés, nous sommes là pour vous guider. Le premier conseil est gratuit et sans engagement."
  />
</BaseLayout>

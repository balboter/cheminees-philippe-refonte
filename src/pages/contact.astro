---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import { url } from "../lib/url";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

const mapsHref =
  "https://www.google.com/maps/dir/?api=1&destination=Centre%20commercial%20Caer%2C%2027930%20Normanville";
---

<BaseLayout
  title="Devis gratuit cheminée Évreux — Cheminées Philippe"
  description="Demandez votre devis gratuit pour une cheminée, un foyer ou un poêle. Showroom Cheminées Philippe à Normanville près d'Évreux, 02 32 33 31 93. Sans engagement."
>
  <HeroEditorial
    kicker="Devis gratuit"
    title="Demandez votre devis gratuit"
    intro="Décrivez votre projet de cheminée, de foyer ou de poêle en quelques lignes, ou appelez directement le showroom. Visite-conseil et devis gratuits, sans engagement."
    image="/images/installations/178.webp"
    imageAlt="Cheminée sur mesure installée dans un séjour, le feu allumé"
    showPhone={true}
    reassurance="Réponse sous 48 h ouvrées — un conseiller vous rappelle."
    height="short"
  />

  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-14 lg:gap-20">
        <div>
          <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
            Demande de devis
          </p>
          <h2 class="mt-5 font-display font-semibold text-ink-900 leading-[1.14] text-3xl sm:text-4xl">
            Dites-nous l'essentiel
          </h2>
          <p class="mt-5 text-lg text-ink-600 leading-relaxed">
            Quelques lignes suffisent. Un conseiller vous rappelle pour préciser
            votre projet et organiser la visite-conseil. Les champs marqués d'un
            astérisque (<span class="text-brand-500">*</span>) sont obligatoires.
          </p>

          <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5">
            {[
              "Réponse sous 48 h ouvrées",
              "Devis gratuit et sans engagement",
              "Visite-conseil offerte à domicile",
            ].map((point) => (
              <li class="flex items-center gap-2 text-ink-700">
                <svg class="w-5 h-5 flex-shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>

          <form
            id="devis-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="mt-10 space-y-7"
          >
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="Demande de devis — Cheminées Philippe" />
            <input type="hidden" name="from_name" value="Site Cheminées Philippe" />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
              <div>
                <label for="nom" class="block text-sm font-semibold text-ink-900">
                  Nom complet <span class="text-brand-500" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="nom"
                  name="nom"
                  required
                  aria-required="true"
                  autocomplete="name"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                />
              </div>
              <div>
                <label for="telephone" class="block text-sm font-semibold text-ink-900">
                  Téléphone <span class="text-brand-500" aria-hidden="true">*</span>
                </label>
                <input
                  type="tel"
                  id="telephone"
                  name="telephone"
                  required
                  aria-required="true"
                  autocomplete="tel"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-ink-900">
                Email <span class="text-brand-500" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                aria-required="true"
                autocomplete="email"
                class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
              <div>
                <label for="type-projet" class="block text-sm font-semibold text-ink-900">
                  Type de projet <span class="text-brand-500" aria-hidden="true">*</span>
                </label>
                <select
                  id="type-projet"
                  name="type_projet"
                  required
                  aria-required="true"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                >
                  <option value="">— Sélectionnez —</option>
                  <option value="Cheminée sur mesure">Cheminée sur mesure</option>
                  <option value="Foyer fermé">Foyer fermé</option>
                  <option value="Insert (rénovation)">Insert (rénovation)</option>
                  <option value="Poêle à bois">Poêle à bois</option>
                  <option value="Poêle à granulés">Poêle à granulés</option>
                  <option value="Je ne sais pas encore">Je ne sais pas encore</option>
                </select>
              </div>
              <div>
                <label for="delai" class="block text-sm font-semibold text-ink-900">
                  Délai souhaité
                </label>
                <select
                  id="delai"
                  name="delai"
                  class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
                >
                  <option value="">— Sélectionnez —</option>
                  <option value="Dès que possible">Dès que possible</option>
                  <option value="Dans les 3 mois">Dans les 3 mois</option>
                  <option value="Avant l'hiver prochain">Avant l'hiver prochain</option>
                  <option value="Je me renseigne">Je me renseigne</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-ink-900">
                Votre projet en quelques mots
                <span class="text-ink-500 font-normal">(facultatif)</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="La pièce, son ambiance, un conduit existant ou non, un style qui vous attire…"
                class="mt-2 w-full px-4 py-3 text-base rounded-md border border-warm-200 bg-warm-50 focus:border-brand-500 focus:bg-white focus-visible:ring-2 focus-visible:ring-brand-500/25 outline-none transition"
              ></textarea>
            </div>

            <p class="text-sm text-ink-500 leading-relaxed">
              Les informations transmises servent uniquement à vous recontacter au
              sujet de votre projet et sont conservées 3 ans après le dernier
              échange. Pour en savoir plus, consultez notre{" "}
              <a
                href={url("/politique-de-confidentialite")}
                class="underline text-brand-500 hover:text-brand-600"
              >
                politique de confidentialité
              </a>.
            </p>

            <button
              type="submit"
              id="submit-btn"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-md bg-brand-500 text-white text-lg font-bold hover:bg-brand-600 transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="submit-label">Demander mon devis gratuit</span>
              <svg id="submit-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>

            <p class="text-center text-sm text-ink-500">
              Devis et visite technique gratuits, sans engagement.
            </p>
          </form>

          <div id="form-success" class="hidden mt-8 p-7 rounded-2xl bg-warm-50 border border-brand-200">
            <h3 class="font-display text-xl text-ink-900">Demande reçue, merci.</h3>
            <p class="mt-2 text-ink-600 leading-relaxed">
              Un conseiller vous rappelle dans les meilleurs délais. Pour nous
              joindre tout de suite, appelez le{" "}
              <a href="tel:+33232333193" class="font-semibold text-brand-500 hover:text-brand-600">
                02 32 33 31 93
              </a>.
            </p>
          </div>

          <div id="form-error" class="hidden mt-8 p-7 rounded-2xl bg-warm-50 border border-brand-300">
            <h3 class="font-display text-xl text-ink-900">L'envoi a échoué.</h3>
            <p class="mt-2 text-ink-600 leading-relaxed">
              Un problème technique nous empêche de recevoir votre demande. Merci
              de nous appeler au{" "}
              <a href="tel:+33232333193" class="font-semibold text-brand-500 hover:text-brand-600">
                02 32 33 31 93
              </a>{" "}
              ou de nous écrire à{" "}
              <a href="mailto:cheminexpo@wanadoo.fr" class="font-semibold text-brand-500 hover:text-brand-600">
                cheminexpo@wanadoo.fr
              </a>.
            </p>
          </div>
        </div>

        <aside class="space-y-10">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-ink-500">
              Vous préférez appeler ?
            </p>
            <a
              href="tel:+33232333193"
              class="block mt-2 font-display text-4xl text-ink-900 hover:text-brand-600 transition-colors duration-300"
            >
              02 32 33 31 93
            </a>
            <p class="mt-3 text-ink-600 leading-relaxed">
              Du mardi au vendredi 9h-12h / 14h-18h, le samedi 10h-12h / 14h-18h.
            </p>
          </div>

          <div class="border-t border-warm-100 pt-10">
            <p class="text-xs uppercase tracking-[0.2em] text-ink-500">
              Le showroom
            </p>
            <address class="mt-2 not-italic text-ink-800 leading-relaxed">
              Centre commercial Caer, Route de Rouen<br />
              27930 Normanville<br />
              <span class="text-ink-500">à quelques minutes d'Évreux</span>
            </address>
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-4 inline-flex items-center gap-2 font-display text-lg text-ink-900 hover:text-brand-600 transition-colors duration-300"
            >
              Ouvrir l'itinéraire<span class="sr-only"> (ouvre dans un nouvel onglet)</span>
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </div>

          <div class="border-t border-warm-100 pt-10">
            <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Par email</p>
            <a
              href="mailto:cheminexpo@wanadoo.fr"
              class="block mt-2 font-display text-xl text-ink-900 hover:text-brand-600 transition-colors duration-300 break-all"
            >
              cheminexpo@wanadoo.fr
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.getElementById("devis-form");
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");
  const submitLabel = document.getElementById("submit-label");
  const submitSpinner = document.getElementById("submit-spinner");

  function restoreSubmit() {
    if (!submitBtn) return;
    submitBtn.disabled = false;
    submitLabel.textContent = "Demander mon devis gratuit";
    submitSpinner.classList.add("hidden");
  }

  async function submitForm(e) {
    e.preventDefault();

    if (form && !form.checkValidity()) {
      form.reportValidity();
      return;
    }

    successEl.classList.add("hidden");
    errorEl.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitLabel.textContent = "Envoi en cours...";
      submitSpinner.classList.remove("hidden");
    }

    const formData = new FormData(form);
    const accessKey = formData.get("access_key");

    if (!accessKey || accessKey === "") {
      restoreSubmit();
      errorEl.classList.remove("hidden");
      errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });
      const json = await res.json();

      if (json.success) {
        form.style.display = "none";
        successEl.classList.remove("hidden");
        successEl.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        throw new Error(json.message || "Erreur inconnue");
      }
    } catch (err) {
      restoreSubmit();
      errorEl.classList.remove("hidden");
      errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  form?.addEventListener("submit", submitForm);
</script>

---
import { url } from "../lib/url";

interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  image: string;
  imageAlt: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPhone?: boolean;
  reassurance?: string;
  height?: "full" | "short";
}

const {
  kicker,
  title,
  intro,
  image,
  imageAlt,
  ctaLabel = "Demander un devis gratuit",
  ctaHref = "/contact",
  showPhone = true,
  reassurance,
  height = "full",
} = Astro.props;

const heightClass =
  height === "full"
    ? "min-h-[88vh] sm:min-h-screen"
    : "min-h-[58vh] sm:min-h-[62vh]";
---

<section class={`relative isolate flex items-end ${heightClass} overflow-hidden`}>
  <img
    src={url(image)}
    alt={imageAlt}
    width="1920"
    height="1280"
    fetchpriority="high"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950/90 via-ink-950/55 to-ink-950/60"
    aria-hidden="true"
  >
  </div>

  <div class="relative w-full mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-14 sm:pb-20 lg:pb-24 pt-32">
    <div class="max-w-3xl">
      {kicker && (
        <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-200 font-semibold">
          {kicker}
        </p>
      )}
      <h1
        class="mt-4 font-display font-semibold text-white leading-[1.1] text-4xl sm:text-5xl lg:text-6xl"
      >
        {title}
      </h1>
      {intro && (
        <p class="mt-5 text-lg sm:text-xl text-white/90 leading-relaxed max-w-2xl">
          {intro}
        </p>
      )}

      {(ctaLabel || showPhone) && (
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-5">
          {ctaLabel && (
            <a
              href={url(ctaHref)}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-brand-500 text-white text-lg font-bold hover:bg-brand-600 transition-colors duration-300"
            >
              {ctaLabel}
            </a>
          )}
          {showPhone && (
            <a
              href="tel:+33232333193"
              class="inline-flex items-center justify-center gap-2.5 px-5 py-4 rounded-md bg-white/10 border border-white/30 text-white font-display text-xl sm:text-2xl hover:bg-white/20 transition-colors duration-300"
            >
              <svg class="w-6 h-6 text-brand-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              02 32 33 31 93
            </a>
          )}
        </div>
      )}

      {reassurance && (
        <p class="mt-6 flex items-center gap-2 text-sm sm:text-base text-white/85">
          <svg class="w-5 h-5 flex-shrink-0 text-brand-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {reassurance}
        </p>
      )}
    </div>
  </div>
</section>
</content>

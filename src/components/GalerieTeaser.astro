---
import { url } from "../lib/url";

const photos = [
  { src: "/images/installations/126.webp", alt: "Cheminée Cheminées Philippe avec habillage pierre dans un salon", tag: "Cheminée · Évreux", size: "tall" },
  { src: "/images/installations/137.webp", alt: "Insert bois intégré dans une cheminée ancienne rénovée", tag: "Insert · Pont-Audemer" },
  { src: "/images/installations/130.webp", alt: "Poêle à granulés Cheminées Philippe dans une pièce à vivre", tag: "Poêle granulés · Verneuil-sur-Avre" },
  { src: "/images/installations/164.webp", alt: "Poêle à bois Cheminées Philippe dans une maison normande", tag: "Poêle bois · Bernay", size: "tall" },
  { src: "/images/installations/123.webp", alt: "Cheminée contemporaine installée dans un salon", tag: "Cheminée · Le Neubourg" },
  { src: "/images/installations/200.webp", alt: "Foyer fermé Cheminées Philippe installé par nos équipes", tag: "Insert · Gaillon" },
];
---

<section class="relative py-16 sm:py-20 lg:py-24 bg-gradient-to-b from-warm-50 to-ink-50 overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 sm:mb-12">
      <div>
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos réalisations
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight font-display">
          Nos cheminées <span class="text-brand-500">chez vous, dans l'Eure</span>
        </h2>
        <p class="mt-4 text-lg text-ink-600 max-w-2xl leading-relaxed">
          Cheminées sur mesure, inserts et poêles posés par nos équipes dans la région.
          Chaque projet est dessiné pour une pièce et une famille.
        </p>
      </div>
      <a
        href={url("/galerie")}
        class="group inline-flex items-center gap-2 font-semibold text-brand-600 hover:text-brand-700 transition whitespace-nowrap"
      >
        Voir toutes les réalisations
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
      {
        photos.map((p) => (
          <a
            href={url("/galerie")}
            class={`group relative overflow-hidden rounded-xl bg-white shadow-md hover:shadow-2xl transition-all duration-500 ${p.size === "tall" ? "md:row-span-2 aspect-[3/4] md:aspect-auto" : "aspect-square"}`}
          >
            <img
              src={url(p.src)}
              alt={p.alt}
              width="600"
              height="600"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900/80 via-ink-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-2 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-500">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/20 backdrop-blur text-white text-xs font-medium border border-white/30">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {p.tag}
                </span>
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

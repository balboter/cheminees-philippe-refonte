---
import { url } from "../lib/url";

const year = new Date().getFullYear();

const navProduits = [
  { href: "/cheminees-sur-mesure", label: "Cheminées sur mesure" },
  { href: "/foyers-inserts", label: "Foyers & inserts" },
  { href: "/poeles", label: "Poêles" },
  { href: "/realisations", label: "Réalisations" },
];
const navMaison = [
  { href: "/atelier", label: "L'atelier & le savoir-faire" },
  { href: "/contact", label: "Contact & devis" },
];
---

<footer class="bg-[#f4efe7] border-t border-warm-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-5">
        <p class="font-display text-2xl font-semibold text-ink-900">
          Cheminées Philippe
        </p>
        <p class="mt-1 text-[11px] uppercase tracking-[0.22em] text-brand-600">
          Évreux · concessionnaire depuis 1986
        </p>
        <p class="mt-6 text-ink-600 leading-relaxed max-w-sm">
          Cheminées dessinées sur mesure, foyers, inserts et poêles de la maison
          Cheminées Philippe. Conçues, fabriquées en France, posées chez vous par
          nos équipes — dans l'Eure et en Normandie.
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="Pages produits">
        <p class="text-[11px] uppercase tracking-[0.2em] text-ink-500">
          Le sur-mesure
        </p>
        <ul class="mt-5 space-y-3">
          {navProduits.map((l) => (
            <li>
              <a href={url(l.href)} class="text-ink-700 hover:text-brand-600 transition">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-5 space-y-3">
          {navMaison.map((l) => (
            <li>
              <a href={url(l.href)} class="text-ink-700 hover:text-brand-600 transition">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="text-[11px] uppercase tracking-[0.2em] text-ink-500">
          Le showroom
        </p>
        <address class="mt-5 not-italic text-ink-700 leading-relaxed">
          Centre commercial Caer, Route de Rouen<br />
          27930 Normanville (Eure)
        </address>
        <p class="mt-4">
          <a
            href="tel:+33232333193"
            class="font-display text-2xl font-semibold text-ink-900 hover:text-brand-600 transition"
          >
            02 32 33 31 93
          </a>
        </p>
        <p class="mt-2">
          <a
            href="mailto:cheminexpo@wanadoo.fr"
            class="text-ink-700 hover:text-brand-600 transition"
          >
            cheminexpo@wanadoo.fr
          </a>
        </p>
        <p class="mt-5 text-sm text-ink-500 leading-relaxed">
          Mardi au vendredi : 9h-12h / 14h-18h<br />
          Samedi : 10h-12h / 14h-18h
        </p>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-warm-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <p class="text-sm text-ink-500">
        © {year} Loisirs Habitat Diffusion SAS — concessionnaire Cheminées Philippe.
      </p>
      <ul class="flex gap-6 text-sm">
        <li>
          <a href={url("/mentions-legales")} class="text-ink-500 hover:text-brand-600 transition">
            Mentions légales
          </a>
        </li>
        <li>
          <a href={url("/politique-de-confidentialite")} class="text-ink-500 hover:text-brand-600 transition">
            Confidentialité
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

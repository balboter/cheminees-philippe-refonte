---
import { url } from "../lib/url";

interface Question {
  q: string;
  a: string;
}

interface Props {
  kicker?: string;
  heading?: string;
  intro?: string;
  questions: Question[];
  variant?: "cream" | "white";
}

const {
  kicker = "Questions fréquentes",
  heading = "Ce que l'on nous demande souvent",
  intro,
  questions,
  variant = "white",
} = Astro.props;

const bg = variant === "cream" ? "bg-warm-50" : "bg-white";
---

<section class={`${bg} py-20 sm:py-24 lg:py-28`}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
        {kicker}
      </p>
      <h2
        class="mt-4 font-display font-semibold text-ink-900 leading-[1.14] text-3xl sm:text-4xl lg:text-5xl"
      >
        {heading}
      </h2>
      {intro && <p class="mt-5 text-lg text-ink-600 leading-relaxed">{intro}</p>}
    </div>

    <div class="mt-12 divide-y divide-warm-100 border-y border-warm-100">
      {questions.map((item) => (
        <details class="group">
          <summary
            class="cursor-pointer list-none flex items-start justify-between gap-6 py-6 font-display text-lg sm:text-xl text-ink-900"
          >
            <span class="flex-1">{item.q}</span>
            <span
              class="flex-shrink-0 mt-1 text-brand-500 transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div class="pb-6 -mt-1 text-ink-600 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>

    <p class="mt-10 text-ink-600">
      Une autre question ?{" "}
      <a
        href={url("/contact")}
        class="text-brand-500 hover:text-brand-600 font-semibold underline-offset-4 underline"
      >
        Demandez votre devis
      </a>{" "}
      ou appelez le{" "}
      <a href="tel:+33232333193" class="text-brand-500 hover:text-brand-600 font-semibold">
        02 32 33 31 93
      </a>.
    </p>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  })}
/>

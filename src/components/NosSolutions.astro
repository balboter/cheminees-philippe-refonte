---
import { url } from "../lib/url";

interface Solution {
  image: string;
  alt: string;
  titre: string;
  texte: string;
  href: string;
  lien: string;
}

interface Props {
  kicker?: string;
  title?: string;
  intro?: string;
  solutions: Solution[];
  variant?: "white" | "warm";
}

const {
  kicker = "Nos solutions",
  title = "Quel projet de feu pour votre maison ?",
  intro,
  solutions,
  variant = "white",
} = Astro.props;

const bg = variant === "warm" ? "bg-warm-50" : "bg-white";
---

<section class={`${bg} py-20 sm:py-24 lg:py-28`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
        {kicker}
      </p>
      <h2 class="mt-4 font-display font-semibold text-ink-900 leading-[1.12] text-3xl sm:text-4xl lg:text-5xl">
        {title}
      </h2>
      {intro && (
        <p class="mt-5 text-lg text-ink-600 leading-relaxed">{intro}</p>
      )}
    </div>

    <div class="mt-12 sm:mt-14 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {solutions.map((s) => (
        <article class="group flex flex-col rounded-xl border border-warm-100 bg-white overflow-hidden transition-shadow duration-300 hover:shadow-lg">
          <a href={url(s.href)} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
            <img
              src={url(s.image)}
              alt={s.alt}
              width="800"
              height="600"
              loading="lazy"
              class="w-full aspect-[4/3] object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
            />
          </a>
          <div class="flex flex-col flex-1 p-6 sm:p-7">
            <h3 class="font-display text-xl sm:text-2xl text-ink-900">
              <a href={url(s.href)} class="hover:text-brand-600 transition-colors">
                {s.titre}
              </a>
            </h3>
            <p class="mt-3 text-ink-600 leading-relaxed flex-1">{s.texte}</p>
            <a
              href={url(s.href)}
              class="mt-6 inline-flex items-center gap-2 font-semibold text-brand-500 hover:text-brand-600 transition-colors"
            >
              {s.lien}
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
</content>

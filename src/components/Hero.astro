---
import { url } from "../lib/url";

const stats = [
  {
    value: "1961",
    label: "fabrication française depuis",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2m-2 0h-2M5 21H3m2 0h2M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/></svg>',
  },
  {
    value: "1986",
    label: "votre concessionnaire local depuis",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
  },
  {
    value: "48 h",
    label: "pour recevoir votre devis",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  },
];
---

<section class="relative isolate overflow-hidden bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={url("/images/installations/200.webp")}
      alt=""
      class="w-full h-full object-cover opacity-25 lg:hidden"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/85 via-ink-900/70 to-ink-900 lg:hidden"></div>
  </div>

  <div
    class="absolute inset-0 opacity-30"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 20% 50%, rgba(168,68,43,0.55) 0%, transparent 55%), radial-gradient(circle at 80% 80%, rgba(168,68,43,0.35) 0%, transparent 55%);"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.06]"
    aria-hidden="true"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;); will-change: auto; transform: translateZ(0);"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/15 border border-brand-500/40 mb-6 shadow-lg shadow-brand-500/10">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          <span class="text-sm font-medium text-brand-300">Concessionnaire Cheminées Philippe depuis 1986</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.08]">
          Votre cheminée, <br class="hidden sm:inline" />
          <span class="text-brand-400">dessinée pour votre pièce.</span>
        </h1>

        <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-ink-200 leading-relaxed max-w-2xl">
          Cheminées sur mesure, inserts et poêles de la marque Cheminées Philippe,
          fabriqués en France. De la conception à l'allumage, tout est pris en main par
          nos équipes — dans l'Eure et en Normandie.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href={url("/contact")}
            class="group inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/40 hover:shadow-xl hover:shadow-brand-500/50 hover:-translate-y-0.5"
          >
            Demander un devis gratuit
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
            </svg>
          </a>
          <a
            href="#estimateur-aides"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25 backdrop-blur-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
            Estimer mes aides
          </a>
        </div>

        <dl class="mt-10 sm:mt-12 grid grid-cols-3 gap-3 sm:gap-6 max-w-lg">
          {stats.map((stat) => (
            <div class="flex flex-col items-start p-3 sm:p-0 rounded-lg sm:rounded-none bg-white/5 sm:bg-transparent border border-white/10 sm:border-0">
              <span class="text-brand-400" set:html={stat.icon} aria-hidden="true" />
              <dt class="mt-1 sm:mt-2 text-xs text-ink-300 uppercase tracking-wider leading-tight">{stat.label}</dt>
              <dd class="mt-1 text-xl sm:text-2xl lg:text-3xl font-bold text-white">{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hidden lg:block lg:col-span-5">
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10">
          <img
            src={url("/images/installations/200.webp")}
            alt="Cheminée Cheminées Philippe installée dans un intérieur en Normandie"
            width="800"
            height="1000"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink-900/80 backdrop-blur text-xs text-white border border-white/10">
              <svg class="w-3 h-3 text-brand-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 2C7 2 5 5 5 8c0 3 1 5 5 10 4-5 5-7 5-10 0-3-2-6-5-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
              </svg>
              Réalisation près d'Évreux
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

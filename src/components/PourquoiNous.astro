---
import { url } from "../lib/url";

interface Atout {
  titre: string;
  texte: string;
}

interface Props {
  kicker?: string;
  title?: string;
  intro?: string;
  image: string;
  imageAlt: string;
  atouts: Atout[];
  variant?: "white" | "warm";
}

const {
  kicker = "Pourquoi nous choisir",
  title = "Un seul interlocuteur, du devis au premier feu",
  intro,
  image,
  imageAlt,
  atouts,
  variant = "warm",
} = Astro.props;

const bg = variant === "white" ? "bg-white" : "bg-warm-50";
---

<section class={`${bg} py-20 sm:py-24 lg:py-28`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <figure class="overflow-hidden rounded-xl order-first">
        <img
          src={url(image)}
          alt={imageAlt}
          width="1000"
          height="1100"
          loading="lazy"
          class="w-full aspect-[10/11] object-cover"
        />
      </figure>

      <div>
        <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
          {kicker}
        </p>
        <h2 class="mt-4 font-display font-semibold text-ink-900 leading-[1.14] text-3xl sm:text-4xl">
          {title}
        </h2>
        {intro && (
          <p class="mt-5 text-lg text-ink-600 leading-relaxed">{intro}</p>
        )}

        <ul class="mt-9 space-y-6">
          {atouts.map((a) => (
            <li class="flex items-start gap-4">
              <span
                class="flex-shrink-0 mt-0.5 flex items-center justify-center w-9 h-9 rounded-full bg-brand-50 text-brand-500"
                aria-hidden="true"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="font-display text-lg sm:text-xl text-ink-900">{a.titre}</p>
                <p class="mt-1.5 text-ink-600 leading-relaxed">{a.texte}</p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href={url("/contact")}
          class="mt-9 inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white text-lg font-bold hover:bg-brand-600 transition-colors duration-300"
        >
          Demander un devis gratuit
        </a>
      </div>
    </div>
  </div>
</section>

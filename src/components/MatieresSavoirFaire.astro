---
import { url } from "../lib/url";

interface Matiere {
  nom: string;
  legende: string;
}

interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  image: string;
  imageAlt: string;
  matieres: Matiere[];
  variant?: "cream" | "white";
}

const {
  kicker = "Matières & savoir-faire",
  title,
  intro,
  image,
  imageAlt,
  matieres,
  variant = "cream",
} = Astro.props;

const bg = variant === "white" ? "bg-white" : "bg-warm-50";
---

<section class={`${bg} py-20 sm:py-24 lg:py-28`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <figure class="overflow-hidden rounded-xl order-first">
        <img
          src={url(image)}
          alt={imageAlt}
          width="1000"
          height="1200"
          loading="lazy"
          class="w-full aspect-[5/6] object-cover"
        />
      </figure>

      <div>
        <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-500 font-semibold">
          {kicker}
        </p>
        <h2
          class="mt-4 font-display font-semibold text-ink-900 leading-[1.14] text-3xl sm:text-4xl lg:text-5xl"
        >
          {title}
        </h2>
        {intro && (
          <p class="mt-5 text-lg text-ink-600 leading-relaxed">{intro}</p>
        )}

        <dl class="mt-10 divide-y divide-warm-100 border-t border-warm-100">
          {matieres.map((m) => (
            <div class="py-5 grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6">
              <dt class="font-display text-lg text-ink-900">{m.nom}</dt>
              <dd class="text-ink-600 leading-relaxed">{m.legende}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

---
import { url } from "../lib/url";

const categories = [
  {
    titre: "Cheminées sur mesure",
    texte:
      "Foyers et cheminées maçonnées, habillage pierre, marbre ou ferronnerie. Dessinées pour votre pièce.",
    href: "/cheminees-sur-mesure",
    image: "/images/installations/126.webp",
    alt: "Cheminée Cheminées Philippe avec habillage pierre dans un salon",
  },
  {
    titre: "Inserts & foyers",
    texte:
      "Transformez une cheminée ancienne en foyer performant : plus de chaleur, moins de bois.",
    href: "/inserts-foyers",
    image: "/images/installations/164.webp",
    alt: "Insert bois Cheminées Philippe intégré dans une cheminée existante",
  },
  {
    titre: "Poêles bois & granulés",
    texte:
      "Poêles à bois et à granulés Cheminées Philippe, posés et réglés par nos techniciens.",
    href: "/poeles",
    image: "/images/installations/123.webp",
    alt: "Poêle à bois Cheminées Philippe installé dans une pièce de vie",
  },
];
---

<section class="py-16 sm:py-20 lg:py-24 bg-warm-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos solutions de chauffage au bois
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight font-display">
        Trois façons de <span class="text-brand-500">chauffer au bois</span>
      </h2>
      <p class="mt-4 text-lg text-ink-600 leading-relaxed">
        Cheminée, insert ou poêle : selon votre logement et votre projet, nous vous
        guidons vers la bonne solution.
      </p>
    </div>

    <div class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        categories.map((cat) => (
          <a
            href={url(cat.href)}
            class="group flex flex-col overflow-hidden rounded-2xl bg-white border border-warm-100 shadow-md hover:shadow-xl hover:border-brand-300 transition-all duration-300"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={url(cat.image)}
                alt={cat.alt}
                width="600"
                height="450"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="flex flex-col flex-1 p-6 sm:p-7">
              <h3 class="text-xl sm:text-2xl font-bold text-ink-900 leading-tight font-display">
                {cat.titre}
              </h3>
              <p class="mt-2 text-base text-ink-600 leading-relaxed flex-1">
                {cat.texte}
              </p>
              <span class="mt-4 inline-flex items-center gap-2 font-semibold text-brand-600 group-hover:text-brand-700 transition">
                Découvrir
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

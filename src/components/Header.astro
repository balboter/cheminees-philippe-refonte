---
import { url } from "../lib/url";

const navLinks = [
  { href: "/cheminees-sur-mesure", label: "Cheminées sur mesure" },
  { href: "/foyers-inserts", label: "Foyers & inserts" },
  { href: "/poeles", label: "Poêles" },
  { href: "/realisations", label: "Réalisations" },
  { href: "/atelier", label: "L'atelier" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-40 transition-colors duration-500"
  data-state="top"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 py-4 lg:py-5">
      <a
        href={url("/")}
        class="flex flex-col leading-none min-w-0"
      >
        <span
          class="header-wordmark font-display text-xl sm:text-2xl font-semibold tracking-tight transition-colors duration-500"
        >
          Cheminées Philippe
        </span>
        <span
          class="header-kicker mt-1 text-xs uppercase tracking-[0.22em] transition-colors duration-500"
        >
          Évreux · depuis 1986
        </span>
      </a>

      <nav aria-label="Navigation principale" class="hidden lg:block">
        <ul class="flex items-center gap-7">
          {navLinks.map((link) => (
            <li>
              <a
                href={url(link.href)}
                class="header-link text-[15px] tracking-wide transition-colors duration-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="hidden md:flex items-center gap-4 lg:gap-5">
        <a
          href="tel:+33232333193"
          class="header-phone inline-flex items-center gap-2 text-base font-semibold transition-colors duration-300"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 33 31 93
        </a>
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center px-5 py-3 rounded-md bg-brand-600 text-white text-[15px] font-bold hover:bg-brand-700 transition-colors duration-300"
        >
          Devis gratuit
        </a>
      </div>

      <button
        type="button"
        class="header-burger lg:hidden flex-shrink-0 -mr-2 flex items-center justify-center w-12 h-12 rounded-full transition-colors duration-300"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-toggle"
      >
        <svg class="w-6 h-6" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav
      aria-label="Navigation mobile"
      id="mobile-menu"
      class="lg:hidden hidden pb-5"
    >
      <ul class="flex flex-col gap-1 rounded-2xl bg-white border border-warm-100 p-3 shadow-xl">
        {navLinks.map((link) => (
          <li>
            <a
              href={url(link.href)}
              class="block py-3 px-3 text-lg text-ink-800 hover:text-brand-700 hover:bg-warm-50 rounded-lg transition"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-2 pt-3 border-t border-warm-100 space-y-2">
          <a
            href="tel:+33232333193"
            class="flex items-center gap-2 py-2 px-3 text-xl font-semibold text-ink-900"
          >
            <svg class="w-5 h-5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            02 32 33 31 93
          </a>
          <a
            href={url("/contact")}
            class="flex items-center justify-center py-3.5 px-3 rounded-md bg-brand-600 text-white text-lg font-bold hover:bg-brand-700 transition-colors"
          >
            Demander un devis gratuit
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* État par-dessus le hero : texte clair sur image sombre */
  #site-header[data-state="top"] {
    background-color: transparent;
  }
  #site-header[data-state="top"] .header-wordmark,
  #site-header[data-state="top"] .header-phone,
  #site-header[data-state="top"] .header-burger {
    color: #ffffff;
  }
  #site-header[data-state="top"] .header-kicker {
    color: var(--color-brand-200);
  }
  #site-header[data-state="top"] .header-link {
    color: rgba(255, 255, 255, 0.9);
  }
  #site-header[data-state="top"] .header-link:hover {
    color: #ffffff;
  }

  /* État après scroll : fond blanc opaque, texte encre */
  #site-header[data-state="scrolled"] {
    background-color: #ffffff;
    box-shadow: 0 1px 0 0 var(--color-warm-100);
  }
  #site-header[data-state="scrolled"] .header-wordmark {
    color: var(--color-ink-900);
  }
  #site-header[data-state="scrolled"] .header-kicker {
    color: var(--color-brand-700);
  }
  #site-header[data-state="scrolled"] .header-phone,
  #site-header[data-state="scrolled"] .header-burger {
    color: var(--color-ink-800);
  }
  #site-header[data-state="scrolled"] .header-link {
    color: var(--color-ink-600);
  }
  #site-header[data-state="scrolled"] .header-link:hover,
  #site-header[data-state="scrolled"] .header-phone:hover {
    color: var(--color-brand-700);
  }
</style>

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    function syncState() {
      if (!header) return;
      const menuOpen = menu && !menu.classList.contains("hidden");
      header.dataset.state = window.scrollY > 40 || menuOpen ? "scrolled" : "top";
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      function () {
        if (!ticking) {
          window.requestAnimationFrame(function () {
            syncState();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    toggle?.addEventListener("click", function () {
      const isHidden = menu?.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", isHidden ? "false" : "true");
      toggle.setAttribute("aria-label", isHidden ? "Ouvrir le menu" : "Fermer le menu");
      iconOpen?.classList.toggle("hidden", !isHidden);
      iconClose?.classList.toggle("hidden", isHidden);
      syncState();
    });

    syncState();
  })();
</script>

---
import { url } from "../lib/url";

const colonnes = [
  {
    type: "bois",
    titre: "Poêle à bois",
    sousTitre: "Le geste et la flamme",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.24 17 6.343 18.485 8.343 17.85 12 16 14a4 4 0 11-6 0c1.5-1.5 1.5-3.5 1.5-3.5"/></svg>',
    accent: false,
    pour: [
      "Vous aimez le rituel : fendre, charger, regarder le feu prendre.",
      "Vous avez de la place pour stocker des bûches au sec.",
      "Vous cherchez le combustible le moins cher.",
      "Un chauffage d'appoint ou de complément vous suffit.",
    ],
    points: [
      { label: "Combustible", valeur: "Bûches de bois", detail: "le coût le plus bas" },
      { label: "Confort", valeur: "Chargement manuel", detail: "le plaisir du geste" },
      { label: "Autonomie", valeur: "4 à 8 h", detail: "selon le modèle" },
      { label: "Entretien", valeur: "Cendres + ramonage", detail: "ramonage annuel obligatoire" },
    ],
  },
  {
    type: "granules",
    titre: "Poêle à granulés",
    sousTitre: "Le confort automatique",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
    accent: true,
    pour: [
      "Vous voulez un chauffage principal qui tourne tout seul.",
      "Vous préférez programmer plutôt que recharger.",
      "Vous cherchez un rendement élevé, supérieur à 90 %.",
      "Vous partez en week-end l'esprit tranquille.",
    ],
    points: [
      { label: "Combustible", valeur: "Granulés de bois", detail: "compétitif vs gaz et électricité" },
      { label: "Confort", valeur: "Programmation auto", detail: "allumage et modulation" },
      { label: "Autonomie", valeur: "24 à 48 h", detail: "sans toucher l'appareil" },
      { label: "Entretien", valeur: "Brûleur + ramonage", detail: "granulés stockés en sac" },
    ],
  },
];
---

<section class="relative py-16 sm:py-20 lg:py-24 bg-gradient-to-b from-white to-warm-50 overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center justify-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Bien choisir
        <span class="inline-block w-8 h-px bg-brand-500"></span>
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight font-display">
        Bois ou granulés : <span class="text-brand-500">lequel pour vous ?</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
        Deux poêles, deux façons de vivre le chauffage. Comparez l'essentiel — nos
        conseillers affinent ensuite avec vous selon votre logement et votre rythme.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      {colonnes.map((col) => (
        <article class={`group relative flex flex-col rounded-2xl border-2 transition-all duration-300 ${col.accent ? "border-brand-300 bg-white shadow-lg shadow-brand-500/10" : "border-ink-100 bg-white hover:border-brand-300"} hover:shadow-xl hover:shadow-brand-500/10 hover:-translate-y-1`}>
          <div class="p-6 sm:p-7 pb-4 border-b border-warm-100">
            <div class={`inline-flex items-center justify-center w-14 h-14 rounded-xl mb-4 ${col.accent ? "bg-brand-500 text-white" : "bg-warm-50 text-brand-600"} group-hover:scale-110 transition-transform`}>
              <span set:html={col.icon} />
            </div>
            <h3 class="text-xl font-bold text-ink-900 font-display">{col.titre}</h3>
            <p class="mt-1 text-sm text-brand-600 font-medium">{col.sousTitre}</p>
          </div>

          <div class="p-6 sm:p-7 pb-2">
            <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">À choisir si</p>
            <ul class="mt-3 space-y-2.5">
              {col.pour.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-700">
                  <svg class="flex-shrink-0 w-4 h-4 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <dl class="flex-1 p-6 sm:p-7 pt-4 grid grid-cols-2 gap-4">
            {col.points.map((p) => (
              <div>
                <dt class="text-xs uppercase tracking-wider text-ink-500 font-semibold">{p.label}</dt>
                <dd class="mt-1">
                  <span class="font-semibold text-ink-900">{p.valeur}</span>
                  <span class="block text-xs text-ink-500 mt-0.5">{p.detail}</span>
                </dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ink-500">
      Vous hésitez encore ? Notre conseiller vient chez vous et tranche selon votre logement —
      <a href={url("/contact")} class="text-brand-600 hover:text-brand-700 font-semibold underline-offset-4 hover:underline">visite technique gratuite</a>.
    </p>
  </div>
</section>

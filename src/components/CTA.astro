---
import { url } from "../lib/url";

interface Props {
  kicker?: string;
  heading: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  kicker = "Parlons-en",
  heading,
  description,
  ctaLabel = "Échanger sur votre projet",
  ctaHref = "/contact",
} = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <img
    src={url("/images/installations/137.webp")}
    alt=""
    width="1920"
    height="1080"
    loading="lazy"
    aria-hidden="true"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-ink-950/78"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40 text-center">
    <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-300">
      {kicker}
    </p>
    <h2
      class="mt-6 font-display font-semibold text-white leading-[1.14] text-3xl sm:text-4xl lg:text-5xl"
    >
      {heading}
    </h2>
    {description && (
      <p class="mt-6 text-lg text-warm-100/90 leading-relaxed">{description}</p>
    )}

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
      <a
        href={url(ctaHref)}
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition-colors duration-300"
      >
        {ctaLabel}
      </a>
      <a
        href="tel:+33232333193"
        class="inline-flex items-center gap-2 text-white font-display text-xl sm:text-2xl hover:text-brand-300 transition-colors duration-300"
      >
        <svg class="w-5 h-5 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        02 32 33 31 93
      </a>
    </div>
  </div>
</section>

---
import { url } from "../lib/url";

interface Props {
  kicker?: string;
  heading: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  reassurance?: string;
}

const {
  kicker = "Votre projet",
  heading,
  description,
  ctaLabel = "Demander un devis gratuit",
  ctaHref = "/contact",
  reassurance = "Visite-conseil et devis gratuits, sans engagement.",
} = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <img
    src={url("/images/installations/137.webp")}
    alt=""
    width="1920"
    height="1080"
    loading="lazy"
    aria-hidden="true"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-ink-950/82"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-20 sm:py-24 lg:py-28 text-center">
    <p class="text-xs sm:text-sm uppercase tracking-[0.22em] text-brand-200 font-semibold">
      {kicker}
    </p>
    <h2
      class="mt-4 font-display font-semibold text-white leading-[1.14] text-3xl sm:text-4xl lg:text-5xl"
    >
      {heading}
    </h2>
    {description && (
      <p class="mt-5 text-lg text-white/90 leading-relaxed">{description}</p>
    )}

    <div class="mt-9 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-5">
      <a
        href={url(ctaHref)}
        class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-brand-500 text-white text-lg font-bold hover:bg-brand-600 transition-colors duration-300"
      >
        {ctaLabel}
      </a>
      <a
        href="tel:+33232333193"
        class="inline-flex items-center justify-center gap-2.5 px-5 py-4 rounded-md bg-white/10 border border-white/30 text-white font-display text-xl sm:text-2xl hover:bg-white/20 transition-colors duration-300"
      >
        <svg class="w-6 h-6 text-brand-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        02 32 33 31 93
      </a>
    </div>

    {reassurance && (
      <p class="mt-6 text-sm sm:text-base text-white/80">{reassurance}</p>
    )}
  </div>
</section>
</content>

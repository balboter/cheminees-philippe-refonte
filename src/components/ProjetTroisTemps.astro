---
interface Temps {
  titre: string;
  texte: string;
}

interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  temps: Temps[];
  variant?: "cream" | "white";
}

const {
  kicker = "Le projet, de l'idée au feu",
  title,
  intro,
  temps,
  variant = "white",
} = Astro.props;

const bg = variant === "cream" ? "bg-[#f4efe7]" : "bg-white";
---

<section class={`${bg} py-20 sm:py-28 lg:py-36`}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-600">
        {kicker}
      </p>
      <h2
        class="mt-5 font-display font-semibold text-ink-900 leading-[1.12] text-3xl sm:text-4xl lg:text-5xl"
      >
        {title}
      </h2>
      {intro && (
        <p class="mt-5 text-lg text-ink-600 leading-relaxed">{intro}</p>
      )}
    </div>

    <ol class="mt-14 sm:mt-16 space-y-12 sm:space-y-16">
      {temps.map((t, i) => (
        <li class="grid grid-cols-1 sm:grid-cols-[5rem_1fr] gap-4 sm:gap-10 items-start">
          <span
            class="font-display text-5xl sm:text-6xl text-brand-500 leading-none"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="border-t border-warm-100 sm:border-0 pt-4 sm:pt-2">
            <h3 class="font-display text-2xl sm:text-3xl text-ink-900">
              {t.titre}
            </h3>
            <p class="mt-3 text-lg text-ink-600 leading-relaxed">{t.texte}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

---
interface Props {
  kicker?: string;
  title: string;
  paragraphs: string[];
  signature?: string;
  variant?: "cream" | "white";
}

const {
  kicker = "Le sur-mesure",
  title,
  paragraphs,
  signature,
  variant = "cream",
} = Astro.props;

const bg = variant === "white" ? "bg-white" : "bg-[#f4efe7]";
---

<section class={`${bg} py-20 sm:py-28 lg:py-36`}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs sm:text-sm uppercase tracking-[0.28em] text-brand-600">
      {kicker}
    </p>
    <h2
      class="mt-6 font-display font-semibold text-ink-900 leading-[1.15] text-3xl sm:text-4xl lg:text-[2.85rem]"
    >
      {title}
    </h2>
    <div class="mt-8 space-y-6">
      {paragraphs.map((p) => (
        <p class="text-lg sm:text-xl text-ink-600 leading-loose">{p}</p>
      ))}
    </div>
    {signature && (
      <p class="mt-10 font-display text-lg text-ink-500 italic">{signature}</p>
    )}
  </div>
</section>

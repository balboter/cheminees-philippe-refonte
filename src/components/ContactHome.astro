---
import { url } from "../lib/url";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<section class="py-16 sm:py-20 lg:py-24 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Parlons de votre projet
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight font-display">
        Un projet en tête ? <span class="text-brand-500">Échangeons.</span>
      </h2>
      <p class="mt-4 text-lg text-ink-600 leading-relaxed">
        Décrivez-nous votre projet en quelques mots, ou appelez directement le showroom.
        On vous rappelle pour caler une visite technique gratuite.
      </p>
    </div>

    <div class="mt-10 sm:mt-14 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <div>
        <form
          id="contact-home-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="p-6 sm:p-8 bg-warm-50 rounded-2xl border border-warm-100 space-y-5"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value="Demande de devis — Cheminées Philippe" />
          <input type="hidden" name="from_name" value="Site Cheminées Philippe" />
          <input type="hidden" name="redirect" value="false" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <p class="text-sm text-ink-500">Les champs marqués d'un astérisque (*) sont obligatoires.</p>

          <div>
            <label for="home-name" class="block text-base font-semibold text-ink-900">
              Votre nom <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="home-name"
              name="name"
              required
              aria-required="true"
              autocomplete="name"
              class="mt-2 w-full px-4 py-3 text-base rounded-md border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 outline-none bg-white transition"
            />
          </div>

          <div>
            <label for="home-tel" class="block text-base font-semibold text-ink-900">
              Téléphone <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="home-tel"
              name="tel"
              required
              aria-required="true"
              autocomplete="tel"
              class="mt-2 w-full px-4 py-3 text-base rounded-md border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 outline-none bg-white transition"
            />
          </div>

          <div>
            <label for="home-projet" class="block text-base font-semibold text-ink-900">
              Votre projet <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <textarea
              id="home-projet"
              name="projet"
              rows="4"
              required
              aria-required="true"
              placeholder="Cheminée, insert ou poêle ? Surface à chauffer, type de logement, délai souhaité..."
              class="mt-2 w-full px-4 py-3 text-base rounded-md border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 outline-none bg-white transition"
            ></textarea>
          </div>

          <p class="text-xs text-ink-600 leading-relaxed">
            Vos informations servent uniquement à vous recontacter. Détails sur la
            <a href={url("/politique-de-confidentialite")} class="underline text-brand-600 hover:text-brand-700">politique de confidentialité</a>.
          </p>

          <button
            type="submit"
            id="home-submit-btn"
            class="group w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-md bg-brand-500 text-white text-lg font-semibold hover:bg-brand-600 transition-all shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="home-submit-label">Demander mon devis</span>
            <svg id="home-submit-arrow" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15" />
            </svg>
            <svg id="home-submit-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <div id="home-form-success" class="hidden mt-6 p-6 bg-brand-50 border-2 border-brand-300 rounded-2xl">
          <h3 class="text-lg font-bold text-ink-900">Demande envoyée, merci !</h3>
          <p class="mt-1 text-ink-700 leading-relaxed">
            Nous vous rappelons sous 48 heures ouvrées. Pour aller plus vite, appelez-nous au
            <a href="tel:+33232333193" class="font-semibold text-brand-600 hover:text-brand-700">02 32 33 31 93</a>.
          </p>
        </div>

        <div id="home-form-error" class="hidden mt-6 p-6 bg-red-50 border-2 border-red-300 rounded-2xl">
          <h3 class="text-lg font-bold text-ink-900">L'envoi a échoué</h3>
          <p class="mt-1 text-ink-700 leading-relaxed">
            Une erreur technique nous empêche de recevoir votre message. Merci de nous
            appeler au <a href="tel:+33232333193" class="font-semibold text-brand-600 hover:text-brand-700">02 32 33 31 93</a>
            ou de nous écrire à <a href="mailto:cheminexpo@wanadoo.fr" class="font-semibold text-brand-600 hover:text-brand-700">cheminexpo@wanadoo.fr</a>.
          </p>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="p-6 sm:p-8 bg-ink-900 text-white rounded-2xl">
          <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider">
            Préférez le téléphone ?
          </p>
          <a
            href="tel:+33232333193"
            class="block mt-3 text-3xl sm:text-4xl font-bold text-white hover:text-brand-300 transition font-display"
          >
            02 32 33 31 93
          </a>
          <p class="mt-2 text-ink-300">
            Du mardi au samedi. Un conseiller vous répond directement.
          </p>
        </div>

        <div class="p-6 sm:p-8 bg-warm-50 border border-warm-100 rounded-2xl">
          <h3 class="text-lg font-bold text-ink-900 font-display">Notre showroom</h3>
          <address class="mt-3 not-italic text-base text-ink-700 leading-relaxed">
            Centre commercial Caer<br />
            Route de Rouen<br />
            27930 Normanville
            <span class="block text-ink-500 text-sm mt-1">À 10 min d'Évreux</span>
          </address>
          <p class="mt-4 text-base text-ink-700 leading-relaxed">
            <strong class="text-ink-900 block">Horaires</strong>
            Mardi - vendredi : 9h-12h / 14h-18h<br />
            Samedi : 10h-12h / 14h-18h<br />
            <span class="text-ink-500">Fermé dimanche et lundi</span>
          </p>
          <a
            href="mailto:cheminexpo@wanadoo.fr"
            class="mt-4 inline-flex items-center gap-2 font-semibold text-brand-600 hover:text-brand-700 transition break-all"
          >
            cheminexpo@wanadoo.fr
          </a>
        </div>

        <a
          href="https://www.google.com/maps/dir/?api=1&destination=Centre%20commercial%20Caer%2C%2027930%20Normanville"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-3 p-5 rounded-2xl bg-warm-50 border border-warm-100 hover:border-brand-300 transition"
        >
          <span class="flex items-center gap-3">
            <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-brand-500 text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <span class="font-semibold text-ink-900">Itinéraire vers le showroom</span>
          </span>
          <svg class="w-5 h-5 text-brand-600 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
          </svg>
        </a>
      </aside>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-home-form");
    const successEl = document.getElementById("home-form-success");
    const errorEl = document.getElementById("home-form-error");
    const submitBtn = document.getElementById("home-submit-btn");
    const submitLabel = document.getElementById("home-submit-label");
    const submitArrow = document.getElementById("home-submit-arrow");
    const submitSpinner = document.getElementById("home-submit-spinner");

    function restoreSubmit() {
      if (!submitBtn) return;
      submitBtn.disabled = false;
      submitLabel.textContent = "Demander mon devis";
      submitSpinner.classList.add("hidden");
      submitArrow.classList.remove("hidden");
    }

    async function submitForm(e) {
      e.preventDefault();

      if (form && !form.checkValidity()) {
        form.reportValidity();
        return;
      }

      successEl.classList.add("hidden");
      errorEl.classList.add("hidden");

      if (submitBtn) {
        submitBtn.disabled = true;
        submitLabel.textContent = "Envoi en cours...";
        submitArrow.classList.add("hidden");
        submitSpinner.classList.remove("hidden");
      }

      const formData = new FormData(form);
      const accessKey = formData.get("access_key");

      if (!accessKey || accessKey === "") {
        restoreSubmit();
        errorEl.classList.remove("hidden");
        errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });
        const json = await res.json();

        if (json.success) {
          form.style.display = "none";
          successEl.classList.remove("hidden");
          successEl.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          throw new Error(json.message || "Erreur inconnue");
        }
      } catch (err) {
        restoreSubmit();
        errorEl.classList.remove("hidden");
        errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    form?.addEventListener("submit", submitForm);
  })();
</script>
